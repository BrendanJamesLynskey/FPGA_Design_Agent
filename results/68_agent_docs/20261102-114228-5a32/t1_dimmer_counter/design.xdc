## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (Nexys-A7-100T-Master.xdc). Pins and I/O standards are the board's; do not edit package pins.

set_property -dict { PACKAGE_PIN N17  IOSTANDARD LVCMOS33 } [get_ports { button_center }];  # BTNC
set_property -dict { PACKAGE_PIN P18  IOSTANDARD LVCMOS33 } [get_ports { button_down }];  # BTND
set_property -dict { PACKAGE_PIN M18  IOSTANDARD LVCMOS33 } [get_ports { button_up }];  # BTNU
set_property -dict { PACKAGE_PIN E3   IOSTANDARD LVCMOS33 } [get_ports { clk }];  # CLK100MHZ
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { clk }];
set_property -dict { PACKAGE_PIN C12  IOSTANDARD LVCMOS33 } [get_ports { cpu_reset_n }];  # CPU_RESETN
set_property -dict { PACKAGE_PIN J17  IOSTANDARD LVCMOS33 } [get_ports { digit_enable_n[0] }];  # AN[0]
set_property -dict { PACKAGE_PIN J18  IOSTANDARD LVCMOS33 } [get_ports { digit_enable_n[1] }];  # AN[1]
set_property -dict { PACKAGE_PIN T9   IOSTANDARD LVCMOS33 } [get_ports { digit_enable_n[2] }];  # AN[2]
set_property -dict { PACKAGE_PIN J14  IOSTANDARD LVCMOS33 } [get_ports { digit_enable_n[3] }];  # AN[3]
set_property -dict { PACKAGE_PIN P14  IOSTANDARD LVCMOS33 } [get_ports { digit_enable_n[4] }];  # AN[4]
set_property -dict { PACKAGE_PIN T14  IOSTANDARD LVCMOS33 } [get_ports { digit_enable_n[5] }];  # AN[5]
set_property -dict { PACKAGE_PIN K2   IOSTANDARD LVCMOS33 } [get_ports { digit_enable_n[6] }];  # AN[6]
set_property -dict { PACKAGE_PIN U13  IOSTANDARD LVCMOS33 } [get_ports { digit_enable_n[7] }];  # AN[7]
set_property -dict { PACKAGE_PIN H17  IOSTANDARD LVCMOS33 } [get_ports { leds[0] }];  # LED[0]
set_property -dict { PACKAGE_PIN K15  IOSTANDARD LVCMOS33 } [get_ports { leds[1] }];  # LED[1]
set_property -dict { PACKAGE_PIN J13  IOSTANDARD LVCMOS33 } [get_ports { leds[2] }];  # LED[2]
set_property -dict { PACKAGE_PIN N14  IOSTANDARD LVCMOS33 } [get_ports { leds[3] }];  # LED[3]
set_property -dict { PACKAGE_PIN R18  IOSTANDARD LVCMOS33 } [get_ports { leds[4] }];  # LED[4]
set_property -dict { PACKAGE_PIN V17  IOSTANDARD LVCMOS33 } [get_ports { leds[5] }];  # LED[5]
set_property -dict { PACKAGE_PIN U17  IOSTANDARD LVCMOS33 } [get_ports { leds[6] }];  # LED[6]
set_property -dict { PACKAGE_PIN U16  IOSTANDARD LVCMOS33 } [get_ports { leds[7] }];  # LED[7]
set_property -dict { PACKAGE_PIN V16  IOSTANDARD LVCMOS33 } [get_ports { leds[8] }];  # LED[8]
set_property -dict { PACKAGE_PIN T15  IOSTANDARD LVCMOS33 } [get_ports { leds[9] }];  # LED[9]
set_property -dict { PACKAGE_PIN U14  IOSTANDARD LVCMOS33 } [get_ports { leds[10] }];  # LED[10]
set_property -dict { PACKAGE_PIN T16  IOSTANDARD LVCMOS33 } [get_ports { leds[11] }];  # LED[11]
set_property -dict { PACKAGE_PIN V15  IOSTANDARD LVCMOS33 } [get_ports { leds[12] }];  # LED[12]
set_property -dict { PACKAGE_PIN V14  IOSTANDARD LVCMOS33 } [get_ports { leds[13] }];  # LED[13]
set_property -dict { PACKAGE_PIN V12  IOSTANDARD LVCMOS33 } [get_ports { leds[14] }];  # LED[14]
set_property -dict { PACKAGE_PIN V11  IOSTANDARD LVCMOS33 } [get_ports { leds[15] }];  # LED[15]
set_property -dict { PACKAGE_PIN T10  IOSTANDARD LVCMOS33 } [get_ports { segments_n[0] }];  # CA
set_property -dict { PACKAGE_PIN R10  IOSTANDARD LVCMOS33 } [get_ports { segments_n[1] }];  # CB
set_property -dict { PACKAGE_PIN K16  IOSTANDARD LVCMOS33 } [get_ports { segments_n[2] }];  # CC
set_property -dict { PACKAGE_PIN K13  IOSTANDARD LVCMOS33 } [get_ports { segments_n[3] }];  # CD
set_property -dict { PACKAGE_PIN P15  IOSTANDARD LVCMOS33 } [get_ports { segments_n[4] }];  # CE
set_property -dict { PACKAGE_PIN T11  IOSTANDARD LVCMOS33 } [get_ports { segments_n[5] }];  # CF
set_property -dict { PACKAGE_PIN L18  IOSTANDARD LVCMOS33 } [get_ports { segments_n[6] }];  # CG
set_property -dict { PACKAGE_PIN H15  IOSTANDARD LVCMOS33 } [get_ports { segments_n[7] }];  # DP
set_property -dict { PACKAGE_PIN J15  IOSTANDARD LVCMOS33 } [get_ports { switches[0] }];  # SW[0]
set_property -dict { PACKAGE_PIN L16  IOSTANDARD LVCMOS33 } [get_ports { switches[1] }];  # SW[1]
set_property -dict { PACKAGE_PIN M13  IOSTANDARD LVCMOS33 } [get_ports { switches[2] }];  # SW[2]
set_property -dict { PACKAGE_PIN R15  IOSTANDARD LVCMOS33 } [get_ports { switches[3] }];  # SW[3]
set_property -dict { PACKAGE_PIN R17  IOSTANDARD LVCMOS33 } [get_ports { switches[4] }];  # SW[4]
set_property -dict { PACKAGE_PIN T18  IOSTANDARD LVCMOS33 } [get_ports { switches[5] }];  # SW[5]
set_property -dict { PACKAGE_PIN U18  IOSTANDARD LVCMOS33 } [get_ports { switches[6] }];  # SW[6]
set_property -dict { PACKAGE_PIN R13  IOSTANDARD LVCMOS33 } [get_ports { switches[7] }];  # SW[7]
set_property -dict { PACKAGE_PIN C4   IOSTANDARD LVCMOS33 } [get_ports { uart_rx }];  # UART_TXD_IN
set_property -dict { PACKAGE_PIN D4   IOSTANDARD LVCMOS33 } [get_ports { uart_tx }];  # UART_RXD_OUT

# Board timing budget: setup 5 ns and zero external hold delay.
set_input_delay -clock sys_clk_pin -max 5.000 [get_ports { cpu_reset_n button_center button_down button_up switches[*] uart_rx }]
set_input_delay -clock sys_clk_pin -min 0.000 [get_ports { cpu_reset_n button_center button_down button_up switches[*] uart_rx }]
# These controls/data are asynchronous to clk. Delay constraints above document their I/O budget;
# suppress synchronous setup/hold analysis across the asynchronous boundary. Internal logic
# after the receiving registers remains fully timed.
set_false_path -from [get_ports { cpu_reset_n button_center button_down button_up switches[*] uart_rx }]
set_output_delay -clock sys_clk_pin -max -3.000 [get_ports { digit_enable_n[*] leds[*] segments_n[*] uart_tx }]
set_output_delay -clock sys_clk_pin -min 0.000 [get_ports { digit_enable_n[*] leds[*] segments_n[*] uart_tx }]
