## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (Nexys-A7-100T-Master.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN J17  IOSTANDARD LVCMOS33 } [get_ports { an[0] }];  # AN[0]
set_property -dict { PACKAGE_PIN J18  IOSTANDARD LVCMOS33 } [get_ports { an[1] }];  # AN[1]
set_property -dict { PACKAGE_PIN T9   IOSTANDARD LVCMOS33 } [get_ports { an[2] }];  # AN[2]
set_property -dict { PACKAGE_PIN J14  IOSTANDARD LVCMOS33 } [get_ports { an[3] }];  # AN[3]
set_property -dict { PACKAGE_PIN P14  IOSTANDARD LVCMOS33 } [get_ports { an[4] }];  # AN[4]
set_property -dict { PACKAGE_PIN T14  IOSTANDARD LVCMOS33 } [get_ports { an[5] }];  # AN[5]
set_property -dict { PACKAGE_PIN K2   IOSTANDARD LVCMOS33 } [get_ports { an[6] }];  # AN[6]
set_property -dict { PACKAGE_PIN U13  IOSTANDARD LVCMOS33 } [get_ports { an[7] }];  # AN[7]
set_property -dict { PACKAGE_PIN N17  IOSTANDARD LVCMOS33 } [get_ports { btn_center }];  # BTNC
set_property -dict { PACKAGE_PIN P18  IOSTANDARD LVCMOS33 } [get_ports { btn_down }];  # BTND
set_property -dict { PACKAGE_PIN M18  IOSTANDARD LVCMOS33 } [get_ports { btn_up }];  # BTNU
set_property -dict { PACKAGE_PIN E3   IOSTANDARD LVCMOS33 } [get_ports { clk }];  # CLK100MHZ
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { clk }];
set_property -dict { PACKAGE_PIN C12  IOSTANDARD LVCMOS33 } [get_ports { cpu_resetn }];  # CPU_RESETN
set_property -dict { PACKAGE_PIN H15  IOSTANDARD LVCMOS33 } [get_ports { dp }];  # DP
set_property -dict { PACKAGE_PIN H17  IOSTANDARD LVCMOS33 } [get_ports { leds[0] }];  # LED[0]
set_property -dict { PACKAGE_PIN K15  IOSTANDARD LVCMOS33 } [get_ports { leds[1] }];  # LED[1]
set_property -dict { PACKAGE_PIN J13  IOSTANDARD LVCMOS33 } [get_ports { leds[2] }];  # LED[2]
set_property -dict { PACKAGE_PIN N14  IOSTANDARD LVCMOS33 } [get_ports { leds[3] }];  # LED[3]
set_property -dict { PACKAGE_PIN R18  IOSTANDARD LVCMOS33 } [get_ports { leds[4] }];  # LED[4]
set_property -dict { PACKAGE_PIN V17  IOSTANDARD LVCMOS33 } [get_ports { leds[5] }];  # LED[5]
set_property -dict { PACKAGE_PIN U17  IOSTANDARD LVCMOS33 } [get_ports { leds[6] }];  # LED[6]
set_property -dict { PACKAGE_PIN U16  IOSTANDARD LVCMOS33 } [get_ports { leds[7] }];  # LED[7]
set_property -dict { PACKAGE_PIN V16  IOSTANDARD LVCMOS33 } [get_ports { leds[8] }];  # LED[8]
set_property -dict { PACKAGE_PIN T15  IOSTANDARD LVCMOS33 } [get_ports { leds[9] }];  # LED[9]
set_property -dict { PACKAGE_PIN U14  IOSTANDARD LVCMOS33 } [get_ports { leds[10] }];  # LED[10]
set_property -dict { PACKAGE_PIN T16  IOSTANDARD LVCMOS33 } [get_ports { leds[11] }];  # LED[11]
set_property -dict { PACKAGE_PIN V15  IOSTANDARD LVCMOS33 } [get_ports { leds[12] }];  # LED[12]
set_property -dict { PACKAGE_PIN V14  IOSTANDARD LVCMOS33 } [get_ports { leds[13] }];  # LED[13]
set_property -dict { PACKAGE_PIN V12  IOSTANDARD LVCMOS33 } [get_ports { leds[14] }];  # LED[14]
set_property -dict { PACKAGE_PIN V11  IOSTANDARD LVCMOS33 } [get_ports { leds[15] }];  # LED[15]
set_property -dict { PACKAGE_PIN T10  IOSTANDARD LVCMOS33 } [get_ports { seg[0] }];  # CA
set_property -dict { PACKAGE_PIN R10  IOSTANDARD LVCMOS33 } [get_ports { seg[1] }];  # CB
set_property -dict { PACKAGE_PIN K16  IOSTANDARD LVCMOS33 } [get_ports { seg[2] }];  # CC
set_property -dict { PACKAGE_PIN K13  IOSTANDARD LVCMOS33 } [get_ports { seg[3] }];  # CD
set_property -dict { PACKAGE_PIN P15  IOSTANDARD LVCMOS33 } [get_ports { seg[4] }];  # CE
set_property -dict { PACKAGE_PIN T11  IOSTANDARD LVCMOS33 } [get_ports { seg[5] }];  # CF
set_property -dict { PACKAGE_PIN L18  IOSTANDARD LVCMOS33 } [get_ports { seg[6] }];  # CG
set_property -dict { PACKAGE_PIN J15  IOSTANDARD LVCMOS33 } [get_ports { switches[0] }];  # SW[0]
set_property -dict { PACKAGE_PIN L16  IOSTANDARD LVCMOS33 } [get_ports { switches[1] }];  # SW[1]
set_property -dict { PACKAGE_PIN M13  IOSTANDARD LVCMOS33 } [get_ports { switches[2] }];  # SW[2]
set_property -dict { PACKAGE_PIN R15  IOSTANDARD LVCMOS33 } [get_ports { switches[3] }];  # SW[3]
set_property -dict { PACKAGE_PIN R17  IOSTANDARD LVCMOS33 } [get_ports { switches[4] }];  # SW[4]
set_property -dict { PACKAGE_PIN T18  IOSTANDARD LVCMOS33 } [get_ports { switches[5] }];  # SW[5]
set_property -dict { PACKAGE_PIN U18  IOSTANDARD LVCMOS33 } [get_ports { switches[6] }];  # SW[6]
set_property -dict { PACKAGE_PIN R13  IOSTANDARD LVCMOS33 } [get_ports { switches[7] }];  # SW[7]
set_property -dict { PACKAGE_PIN C4   IOSTANDARD LVCMOS33 } [get_ports { uart_rxd }];  # UART_TXD_IN
set_property -dict { PACKAGE_PIN D4   IOSTANDARD LVCMOS33 } [get_ports { uart_txd }];  # UART_RXD_OUT

# Budget top-level I/O against the system clock; asynchronous board inputs
# are sampled by RTL synchronizers, and external outputs are board indicators.
set_input_delay -clock [get_clocks sys_clk_pin] -max 0.500 [get_ports { cpu_resetn btn_up btn_down btn_center switches[*] uart_rxd }]
set_input_delay -clock [get_clocks sys_clk_pin] -min 0.000 [get_ports { cpu_resetn btn_up btn_down btn_center switches[*] uart_rxd }]
set_output_delay -clock [get_clocks sys_clk_pin] -max 0.500 [get_ports { leds[*] seg[*] dp an[*] uart_txd }]
set_output_delay -clock [get_clocks sys_clk_pin] -min 0.000 [get_ports { leds[*] seg[*] dp an[*] uart_txd }]
# These board controls and indicators have no synchronous external capture
# clock. Do not treat their asynchronous pin paths as synchronous timing paths.
set_false_path -from [get_ports { cpu_resetn btn_up btn_down btn_center switches[*] uart_rxd }]
set_false_path -to [get_ports { leds[*] seg[*] dp an[*] uart_txd }]
