## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (Nexys-A7-100T-Master.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN E3   IOSTANDARD LVCMOS33 } [get_ports { CLK100MHZ }];  # CLK100MHZ
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { CLK100MHZ }];
set_property -dict { PACKAGE_PIN C12  IOSTANDARD LVCMOS33 } [get_ports { CPU_RESETN }];  # CPU_RESETN
set_property -dict { PACKAGE_PIN H17  IOSTANDARD LVCMOS33 } [get_ports { LED[0] }];  # LED[0]
set_property -dict { PACKAGE_PIN D4   IOSTANDARD LVCMOS33 } [get_ports { UART_RXD_OUT }];  # UART_RXD_OUT
set_property -dict { PACKAGE_PIN C4   IOSTANDARD LVCMOS33 } [get_ports { UART_TXD_IN }];  # UART_TXD_IN

## Asynchronous inputs (reset button, UART serial in): synchronised inside the design;
## the delay only gives the ports a defined arrival time (FDA-CON-5).
set ASYNC_IN [get_ports {CPU_RESETN UART_TXD_IN}]
set_input_delay -clock sys_clk_pin -max 2.0 $ASYNC_IN
set_input_delay -clock sys_clk_pin -min 0.0 $ASYNC_IN

## Outputs (UART serial out, ready LED): slow board-level signals, no external timing
## requirement; a nominal output delay constrains them against the clock (FDA-CON-5).
set SLOW_OUT [get_ports {UART_RXD_OUT LED[0]}]
set_output_delay -clock sys_clk_pin -max 2.0 $SLOW_OUT
set_output_delay -clock sys_clk_pin -min 0.0 $SLOW_OUT
