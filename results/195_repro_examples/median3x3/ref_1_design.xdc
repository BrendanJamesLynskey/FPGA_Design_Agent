## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (Nexys-A7-100T-Master.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN E3   IOSTANDARD LVCMOS33 } [get_ports { CLK100MHZ }];  # CLK100MHZ
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { CLK100MHZ }];
set_property -dict { PACKAGE_PIN C12  IOSTANDARD LVCMOS33 } [get_ports { CPU_RESETN }];  # CPU_RESETN
set_property -dict { PACKAGE_PIN D4   IOSTANDARD LVCMOS33 } [get_ports { UART_RXD_OUT }];  # UART_RXD_OUT
set_property -dict { PACKAGE_PIN C4   IOSTANDARD LVCMOS33 } [get_ports { UART_TXD_IN }];  # UART_TXD_IN

# Asynchronous inputs (reset button, UART RX from host): no timing relationship to the clock;
# both are synchronised inside the design, so zero delay and a false path.
set_input_delay -clock sys_clk_pin -max 0.0 [get_ports { CPU_RESETN UART_TXD_IN }]
set_input_delay -clock sys_clk_pin -min 0.0 [get_ports { CPU_RESETN UART_TXD_IN }]
set_false_path -from [get_ports { CPU_RESETN UART_TXD_IN }]

# UART transmit output to the host: asynchronous 115200 baud serial, no timing relationship;
# zero delay and a false path.
set_output_delay -clock sys_clk_pin -max 0.0 [get_ports { UART_RXD_OUT }]
set_output_delay -clock sys_clk_pin -min 0.0 [get_ports { UART_RXD_OUT }]
set_false_path -to [get_ports { UART_RXD_OUT }]
