## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (Nexys-A7-100T-Master.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN E3   IOSTANDARD LVCMOS33 } [get_ports { CLK100MHZ }];  # CLK100MHZ
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { CLK100MHZ }];
set_property -dict { PACKAGE_PIN C12  IOSTANDARD LVCMOS33 } [get_ports { CPU_RESETN }];  # CPU_RESETN
set_property -dict { PACKAGE_PIN D4   IOSTANDARD LVCMOS33 } [get_ports { UART_RXD_OUT }];  # UART_RXD_OUT
set_property -dict { PACKAGE_PIN C4   IOSTANDARD LVCMOS33 } [get_ports { UART_TXD_IN }];  # UART_TXD_IN

# FDA-CON-5: CPU_RESETN (push button) and UART_TXD_IN (115200 baud host line) are asynchronous
# to the clock and resynchronised in the design: zero delay plus false path.
set IN_PORTS [get_ports { CPU_RESETN UART_TXD_IN }]
set_input_delay -clock sys_clk_pin -max 0.0 $IN_PORTS
set_input_delay -clock sys_clk_pin -min 0.0 $IN_PORTS
set_false_path -from $IN_PORTS

# FDA-CON-5: UART_RXD_OUT is a slow 115200 baud line to the USB-UART bridge with no timing
# relationship to the clock: zero delay plus false path.
set OUT_PORTS [get_ports { UART_RXD_OUT }]
set_output_delay -clock sys_clk_pin -max 0.0 $OUT_PORTS
set_output_delay -clock sys_clk_pin -min 0.0 $OUT_PORTS
set_false_path -to $OUT_PORTS
