# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y8 [get_cells g_chain.g_st[8].u_st]
set_property LOC BUFGCTRL_X0Y7 [get_cells g_chain.g_st[7].u_st]
set_property LOC BUFGCTRL_X0Y6 [get_cells g_chain.g_st[6].u_st]
set_property LOC BUFGCTRL_X0Y5 [get_cells g_chain.g_st[5].u_st]
set_property LOC BUFGCTRL_X0Y4 [get_cells g_chain.g_st[4].u_st]
set_property LOC BUFGCTRL_X0Y3 [get_cells g_chain.g_st[3].u_st]
set_property LOC BUFGCTRL_X0Y2 [get_cells g_chain.g_st[2].u_st]
set_property LOC BUFGCTRL_X0Y1 [get_cells g_chain.g_st[1].u_st]
set_property LOC BUFGCTRL_X0Y11 [get_cells g_chain.g_st[11].u_st]
set_property LOC BUFGCTRL_X0Y10 [get_cells g_chain.g_st[10].u_st]
set_property LOC BUFGCTRL_X0Y9 [get_cells g_chain.g_st[9].u_st]
