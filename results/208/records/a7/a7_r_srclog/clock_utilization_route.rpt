# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y1 [get_cells g_bufgmux.u_mux]
set_property LOC BUFGCTRL_X0Y2 [get_cells u_bufg1]
set_property LOC BUFGCTRL_X0Y0 [get_cells u_bufg0]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y28 [get_ports clk0_p]

# Clock net "clkm" driven by instance "g_bufgmux.u_mux" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_clkm}
add_cells_to_pblock [get_pblocks  {CLKAG_clkm}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clkm"}]]]
resize_pblock [get_pblocks {CLKAG_clkm}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

# Clock net "clk1" driven by instance "u_bufg1" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_clk1}
add_cells_to_pblock [get_pblocks  {CLKAG_clk1}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk1"}]]]
resize_pblock [get_pblocks {CLKAG_clk1}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

# Clock net "clk0" driven by instance "u_bufg0" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_clk0}
add_cells_to_pblock [get_pblocks  {CLKAG_clk0}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk0"}]]]
resize_pblock [get_pblocks {CLKAG_clk0}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup
