     "high": 1,
     "basis": "model",
     "cites": [
      "stage.cross_go.clocks"
     ],
     "basis_note": "cross_go adds 4 clocks. Removing the output register saves 1 clock. Removing a synchroniser flop would save more, but I do not propose that because it lowers MTBF.",
     "ceiling": 4.0,
     "ceiling_basis": "the clocks of the touched stages (4)",
