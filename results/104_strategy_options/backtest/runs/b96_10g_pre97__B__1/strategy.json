     "cli": "--scope core"
    },
    "approach": "In core, replace the xpm_cdc_pulse u_p_go (toggle flop, 2 synchroniser flops, edge detect, output register) with a shorter pulse crossing, for example dropping the output register, so cross_go takes fewer clocks. The order bus crossing, the 3-flop quasi-static bus and the synchroniser depth are not changed. The pulse must still arrive after the order bus has settled in frame_src.",
    "techniques": [
     "shorten_cdc",
     "remove_register_stage"
    ],
    "touches_stages": [
     "cross_go"
    ],
    "stage_components": {
