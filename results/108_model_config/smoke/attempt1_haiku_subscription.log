   {
    "id": "q1",
    "text": "What is the count value at power-on before any BTNC reset?",
    "default": "Undefined, no power-on reset, the first btnc press sets it to 0",
    "reason": "The request defines only the BTNC reset; adding a power-on reset would be an extra feature, so the default keeps the spec to what is asked",
    "answer": "Undefined, no power-on reset, the first btnc press sets it to 0",
    "status": "defaulted",
    "by": "default",
    "evidence": null
   },
   {
    "id": "q2",
    "text": "Should btnc be debounced so one press counts as one reset?",
    "default": "No debounce, btnc is only synchronised with two flip-flops",
    "reason": "The request does not mention debounce and a reset-to-zero is idempotent, so a bounce only re-clears the counter",
    "answer": "No debounce, btnc is only synchronised with two flip-flops",
    "status": "defaulted",
    "by": "default",
    "evidence": null
   },
   {
    "id": "q3",
    "text": "Does btnc reset the count while sw0 is low?",
    "default": "Yes, btnc resets regardless of sw0",
    "reason": "The request says BTNC resets the counter with no condition on SW0, so the reset is unconditional",
    "answer": "Yes, btnc resets regardless of sw0",
    "status": "defaulted",
    "by": "default",
    "evidence": null
   },
   {
    "id": "q4",
    "text": "Should sw0 pass through a synchroniser or be used directly?",
    "default": "Synchronise sw0 with two flip-flops, giving a 3-edge enable latency",
    "reason": "sw0 is asynchronous to clk, and the latency is a fixed known number of cycles that the testbench can model",
    "answer": "Synchronise sw0 with two flip-flops, giving a 3-edge enable latency",
    "status": "defaulted",
