+-----------------------------------------------------------------------------------------------------------------+
; Create Clock                                                                                                    ;
+--------------+-------+--------+-----------------+---------------------+-----------+------------------+----------+
; SDC Command  ; Name  ; Period ; Waveform        ; Targets             ; Add Clock ; Location         ; Comments ;
+--------------+-------+--------+-----------------+---------------------+-----------+------------------+----------+
; create_clock ; clk_a ; 10.000 ; { 0.000 5.000 } ; [get_ports {clk_a}] ;           ; q_variant.sdc:11 ;          ;
; create_clock ; clk_b ; 6.400  ; { 0.000 3.200 } ; [get_ports {clk_b}] ;           ; q_variant.sdc:12 ;          ;
+--------------+-------+--------+-----------------+---------------------+-----------+------------------+----------+

