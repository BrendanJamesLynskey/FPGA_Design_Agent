+-----------------------+-------+------------+----------------------+----------+----------------------+-------------+-----------+----------+
; set_clock_uncertainty ;       ; -rise_from ; [get_clocks {clk_b}] ; -rise_to ; [get_clocks {clk_b}] ; 0.020       ; Generated ;          ;
; set_clock_uncertainty ;       ; -rise_from ; [get_clocks {clk_b}] ; -fall_to ; [get_clocks {clk_b}] ; 0.020       ; Generated ;          ;
; set_clock_uncertainty ;       ; -fall_from ; [get_clocks {clk_b}] ; -rise_to ; [get_clocks {clk_b}] ; 0.020       ; Generated ;          ;
; set_clock_uncertainty ;       ; -fall_from ; [get_clocks {clk_b}] ; -fall_to ; [get_clocks {clk_b}] ; 0.020       ; Generated ;          ;
; set_clock_uncertainty ;       ; -rise_from ; [get_clocks {clk_a}] ; -rise_to ; [get_clocks {clk_a}] ; 0.020       ; Generated ;          ;
; set_clock_uncertainty ;       ; -rise_from ; [get_clocks {clk_a}] ; -fall_to ; [get_clocks {clk_a}] ; 0.020       ; Generated ;          ;
; set_clock_uncertainty ;       ; -fall_from ; [get_clocks {clk_a}] ; -rise_to ; [get_clocks {clk_a}] ; 0.020       ; Generated ;          ;
; set_clock_uncertainty ;       ; -fall_from ; [get_clocks {clk_a}] ; -fall_to ; [get_clocks {clk_a}] ; 0.020       ; Generated ;          ;
+-----------------------+-------+------------+----------------------+----------+----------------------+-------------+-----------+----------+

