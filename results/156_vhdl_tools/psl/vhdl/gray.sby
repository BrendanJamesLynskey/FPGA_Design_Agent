# Brief 156: the same properties in PSL on the VHDL translation (brief 55, arm A), through the GHDL Yosys plugin
# `ghdl -fpsl` reads the `-- psl` comments. TOOLCHAIN picks the plugin; run_psl_formal.py substitutes it.
[tasks]
bmc
cover

[options]
bmc: mode bmc
cover: mode cover
depth 20

[engines]
smtbmc z3

[script]
@PLUGIN@
ghdl --std=08 -fpsl -gDEBOUNCE_CYCLES=2 -gTICK_CYCLES=2 sync2.vhd bm_debounce.vhd gray_stepper.vhd -e gray_stepper
prep -top gray_stepper

[files]
../rtl/sync2.vhd
../rtl/bm_debounce.vhd
@GRAY@
