set_property -dict { PACKAGE_PIN C3 IOSTANDARD LVCMOS18 } [get_ports { clk_25 }]
create_clock -name clk_25 -period 40.0 [get_ports clk_25]
set_property -dict { PACKAGE_PIN A1 IOSTANDARD LVCMOS18 } [get_ports { a_rxd[0] }]
set_property -dict { PACKAGE_PIN B3 IOSTANDARD LVCMOS18 } [get_ports { a_rxd[1] }]
set_property -dict { PACKAGE_PIN A3 IOSTANDARD LVCMOS18 } [get_ports { a_rxd[2] }]
set_property -dict { PACKAGE_PIN B4 IOSTANDARD LVCMOS18 } [get_ports { a_rxd[3] }]
set_property -dict { PACKAGE_PIN A4 IOSTANDARD LVCMOS18 } [get_ports { a_rx_ctl }]
set_property -dict { PACKAGE_PIN E1 IOSTANDARD LVCMOS18 } [get_ports { a_txd[0] }]
set_property -dict { PACKAGE_PIN D1 IOSTANDARD LVCMOS18 } [get_ports { a_txd[1] }]
set_property -dict { PACKAGE_PIN F2 IOSTANDARD LVCMOS18 } [get_ports { a_txd[2] }]
set_property -dict { PACKAGE_PIN E2 IOSTANDARD LVCMOS18 } [get_ports { a_txd[3] }]
set_property -dict { PACKAGE_PIN F1 IOSTANDARD LVCMOS18 } [get_ports { a_tx_ctl }]
set_input_delay  -clock clk_25 -max 5.0 [get_ports {a_rxd[*] a_rx_ctl}]
set_input_delay  -clock clk_25 -min 1.0 [get_ports {a_rxd[*] a_rx_ctl}]
set_output_delay -clock clk_25 -max 5.0 [get_ports {a_txd[*] a_tx_ctl}]
set_output_delay -clock clk_25 -min -1.0 [get_ports {a_txd[*] a_tx_ctl}]
