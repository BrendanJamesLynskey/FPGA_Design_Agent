diff --git a/designs/b96_kr260_10g/latency_stages.yaml b/designs/b96_kr260_10g/latency_stages.yaml
index d8d3cf67..6b8d37a7 100644
--- a/designs/b96_kr260_10g/latency_stages.yaml
+++ b/designs/b96_kr260_10g/latency_stages.yaml
@@ -77,23 +77,23 @@ paths:
         name: "trade64 decision register (`fire`, o_price, o_inst)"
         domain: rx
         kind: reg
-        clocks: 1
+        clocks: 0
         registers: ["*u_rx/u_td/fire_reg", "*u_rx/u_td/o_price_reg[*]"]
-        why: "the price compare (price <= thr, 32 bits) and the arm/kill/enable interlock are registered before the order is requested"
+        why: "the price compare (price <= thr, 32 bits) and the arm/kill/enable interlock feed the crossing's source flop in the same clock (no decision register)"
         remove_risk: "an early decision from the lower word bytes is a design change (the price is complete only in word 7); removing the register puts the compare in front of the crossing flop"
-        technique: merge_stages
-        removable: 1
+        technique: none
+        removable: 0
       - id: cross_go
         segment: fire_to_go
-        name: "receive-to-transmit crossing of the go pulse (xpm_cdc_pulse u_p_go: toggle flop, 2 synchroniser flops, edge detect, output register)"
+        name: "receive-to-transmit crossing of the go pulse (xpm_cdc_pulse u_p_go: toggle flop, 2 synchroniser flops, edge detect; no output register)"
         domain: rx->tx
         kind: cdc
-        clocks: 4
+        clocks: 3
         registers: ["*u_p_go/*"]
         why: "the order is requested in the recovered-clock domain and sent in the transmit-clock domain; the two clocks are independent"
         remove_risk: "fewer synchroniser flops raise the metastability failure rate (MTBF); the order bus beside the pulse is sampled 4 clocks later by frame_src, so an earlier pulse must still find the bus settled (`stale` counts misses); the quasi-static bus uses 3 flops"
-        technique: shorten_cdc
-        removable: 1
+        technique: none
+        removable: 0
       - id: fs_start
         segment: go_to_preamble
         name: "frame_src start -> s_valid, s_data (word 0)"
