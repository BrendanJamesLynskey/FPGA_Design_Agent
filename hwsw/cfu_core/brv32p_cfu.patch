diff -ruN a/rtl/core/brv32p_core.v b/rtl/core/brv32p_core.v
--- a/rtl/core/brv32p_core.v	2026-11-13 00:42:09.848012336 +0000
+++ b/rtl/core/brv32p_core.v	2026-11-13 00:42:20.805658540 +0000
@@ -3,6 +3,7 @@
 // ============================================================================
 
 `include "brv32p_bp.vh"
+`include "cfu_ops.vh"          // the generated unit's module name and encodings (hwsw/cfu.py)
 
 module brv32p_core #(
   parameter [31:0] RESET_PC = 32'h0000_0000,
@@ -385,6 +386,26 @@
     .valid  (muldiv_valid)
   );
 
+  // A generated custom-instruction unit (custom-2, hwsw/cfu.py): runs in EX and holds the pipeline while busy, with
+  // the divider's handshake; its result leaves EX on the WB_DSP path
+  wire        cfu_ex = valid_ex && (raw_ex[6:0] == OP_CUSTOM2) && !ctrl_ex[`CTRL_ILLEGAL];
+  wire [31:0] cfu_result;
+  wire        cfu_busy, cfu_valid;
+  `CFU_MODULE u_cfu (
+    .clk    (clk),
+    .rst_n  (rst_n),
+    .start  (cfu_ex),
+    .hold   (mem_stall),
+    .kill   (flush_ex && !mem_stall),
+    .funct3 (raw_ex[14:12]),
+    .funct7 (raw_ex[31:25]),
+    .a      (rs1_fwd),
+    .b      (rs2_fwd),
+    .result (cfu_result),
+    .busy   (cfu_busy),
+    .valid  (cfu_valid)
+  );
+
   // Xbrvdsp: multiply-accumulate. An accumulator instruction updates acc as
   // it moves from EX to MEM (not while held, and not if a trap flushes it)
   wire dsp_ex = valid_ex && (raw_ex[6:0] == OP_CUSTOM0) && !ctrl_ex[`CTRL_ILLEGAL];
@@ -546,7 +567,8 @@
       WB_PC4:    ex_result = pc_ex + pc_inc_ex;
       WB_MULDIV: ex_result = muldiv_result;
       WB_AUIPC:  ex_result = auipc_result;
-      WB_DSP:    ex_result = (raw_ex[6:0] != OP_CUSTOM0)  ? zk_result :
+      WB_DSP:    ex_result = (raw_ex[6:0] == OP_CUSTOM2)  ? cfu_result :
+                             (raw_ex[6:0] != OP_CUSTOM0)  ? zk_result :
                              (raw_ex[14:12] == 3'b101) ? gf_result : dsp_result;
       WB_AGU:    ex_result = (raw_ex[23:22] == 2'b10) ? loop_result : agu_result;   // lp.rd : ar.rd*
       WB_MEM:    ex_result = mem_addr_ex;
@@ -808,7 +830,7 @@
     .branch_mispredict(branch_mispredict_ex || trap_enter || mret_ex || fencei_take),
     .jump_ex          (ctrl_ex[`CTRL_JAL] || ctrl_ex[`CTRL_JALR]),
     .trap             (trap_enter),
-    .muldiv_busy      (muldiv_busy),
+    .muldiv_busy      (muldiv_busy || cfu_busy),
     .fwd_rs1          (fwd_rs1),
     .fwd_rs2          (fwd_rs2),
     .stall_if         (stall_if),
diff -ruN a/rtl/core/decoder.v b/rtl/core/decoder.v
--- a/rtl/core/decoder.v	2026-11-13 00:42:09.848187911 +0000
+++ b/rtl/core/decoder.v	2026-11-13 00:42:09.902510220 +0000
@@ -5,6 +5,8 @@
 // bundle plus register addresses and immediate value.
 // ============================================================================
 
+`include "cfu_ops.vh"
+
 module decoder (
   input  wire [31:0]          instr,
   output wire [4:0]           rs1_addr,
@@ -247,6 +249,15 @@
         end else
           ctrl[`CTRL_ILLEGAL] = 1'b1;
       end
+
+      // A generated custom-instruction unit (cfu_*.sv): R-type, writes rd; the encodings it decodes are in cfu_ops.vh
+      OP_CUSTOM2: begin
+        if (`CFU_LEGAL(funct3, funct7)) begin
+          ctrl[`CTRL_REG_WR] = 1'b1;
+          ctrl[`CTRL_WB_SEL] = WB_DSP;
+        end else
+          ctrl[`CTRL_ILLEGAL] = 1'b1;
+      end
 
       default: begin
         ctrl[`CTRL_ILLEGAL] = 1'b1;
diff -ruN a/rtl/pkg/brv32p_defs.vh b/rtl/pkg/brv32p_defs.vh
--- a/rtl/pkg/brv32p_defs.vh	2026-11-13 00:42:09.850284726 +0000
+++ b/rtl/pkg/brv32p_defs.vh	2026-11-13 00:42:09.902053478 +0000
@@ -46,6 +46,7 @@
 localparam [6:0] OP_SYSTEM = 7'b1110011;
 localparam [6:0] OP_CUSTOM0 = 7'b0001011;   // Xbrvdsp (dsp_unit.v)
 localparam [6:0] OP_CUSTOM1 = 7'b0101011;   // Xbrvdsp address generators (agu.v)
+localparam [6:0] OP_CUSTOM2 = 7'b1011011;   // a generated custom-instruction unit (FPGA_Design_Agent hwsw/cfu.py)
 
 // ── ALU Operations ───────────────────────────────────────────────────
 localparam [3:0] ALU_ADD    = 4'b0000;
