# SymbiYosys: pipe_reg, one task per (MODE, N) at W = 4. prove: k-induction (all behaviours); cover: a beat reaches the output.
# MODE 0 FWD, 1 SKID, 2 FULL, 3 HALF, 4 COMB. Run: python3 ip_lib/pipe_reg/formal/run_formal.py
[tasks]
fwd1 prove
fwd3 prove
skid1 prove
skid2 prove
skid3 prove
full1 prove
full2 prove
full3 prove
half1 prove
half2 prove
comb1 prove
comb2 prove
comb3 prove
wire0 prove
skid2c cover

[options]
prove: mode prove
prove: depth 14
cover: mode cover
cover: depth 20

[engines]
smtbmc boolector

[script]
read_verilog -formal -DFORMAL -sv pipe_reg.sv pipe_reg_slice.sv formal_pipe.sv
fwd1: chparam -set MODE 0 -set N 1 formal_pipe
fwd3: chparam -set MODE 0 -set N 3 formal_pipe
skid1: chparam -set MODE 1 -set N 1 formal_pipe
skid2: chparam -set MODE 1 -set N 2 formal_pipe
skid3: chparam -set MODE 1 -set N 3 formal_pipe
skid2c: chparam -set MODE 1 -set N 2 formal_pipe
full1: chparam -set MODE 2 -set N 1 formal_pipe
full2: chparam -set MODE 2 -set N 2 formal_pipe
full3: chparam -set MODE 2 -set N 3 formal_pipe
half1: chparam -set MODE 3 -set N 1 formal_pipe
half2: chparam -set MODE 3 -set N 2 formal_pipe
comb1: chparam -set MODE 4 -set N 1 formal_pipe
comb2: chparam -set MODE 4 -set N 2 formal_pipe
comb3: chparam -set MODE 4 -set N 3 formal_pipe
wire0: chparam -set MODE 1 -set N 0 formal_pipe
prep -top formal_pipe

[files]
../rtl/pipe_reg.sv
../rtl/pipe_reg_slice.sv
formal_pipe.sv
