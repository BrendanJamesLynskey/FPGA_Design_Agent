# SymbiYosys with the slang front end: the AXI4-Stream rules as assertions (tb/axis_sva.sv) on both ports of pipe_reg, proved by
# k-induction beside the data properties (the SVA module is the one a Verilator or xsim bench would bind).
# Run: python3 ip_lib/pipe_reg/formal/run_formal.py --sva
[tasks]
sva_fwd3 prove
sva_skid1 prove
sva_skid2 prove
sva_full2 prove
sva_half2 prove
sva_comb2 prove
sva_wire0 prove

[options]
prove: mode prove
prove: depth 14

[engines]
smtbmc boolector

[script]
plugin -i slang
sva_fwd3: read_slang -DFORMAL -DSVA pipe_reg.sv pipe_reg_slice.sv formal_pipe.sv axis_sva.sv --top formal_pipe -G MODE=0 -G N=3
sva_skid1: read_slang -DFORMAL -DSVA pipe_reg.sv pipe_reg_slice.sv formal_pipe.sv axis_sva.sv --top formal_pipe -G MODE=1 -G N=1
sva_skid2: read_slang -DFORMAL -DSVA pipe_reg.sv pipe_reg_slice.sv formal_pipe.sv axis_sva.sv --top formal_pipe -G MODE=1 -G N=2
sva_full2: read_slang -DFORMAL -DSVA pipe_reg.sv pipe_reg_slice.sv formal_pipe.sv axis_sva.sv --top formal_pipe -G MODE=2 -G N=2
sva_half2: read_slang -DFORMAL -DSVA pipe_reg.sv pipe_reg_slice.sv formal_pipe.sv axis_sva.sv --top formal_pipe -G MODE=3 -G N=2
sva_comb2: read_slang -DFORMAL -DSVA pipe_reg.sv pipe_reg_slice.sv formal_pipe.sv axis_sva.sv --top formal_pipe -G MODE=4 -G N=2
sva_wire0: read_slang -DFORMAL -DSVA pipe_reg.sv pipe_reg_slice.sv formal_pipe.sv axis_sva.sv --top formal_pipe -G MODE=1 -G N=0
prep -top formal_pipe

[files]
../rtl/pipe_reg.sv
../rtl/pipe_reg_slice.sv
formal_pipe.sv
../tb/axis_sva.sv
