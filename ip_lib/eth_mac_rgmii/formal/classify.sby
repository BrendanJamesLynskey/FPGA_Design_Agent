# SymbiYosys: eth_rx_classify's address filter against the rule restated in the harness. bmc: bounded, depth 12
# (a destination address with gaps and its verdict); cover: a multicast address accepted by the table or the hash.
[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 12
cover: mode cover
cover: depth 16

[engines]
smtbmc boolector

[script]
read_verilog -formal -sv eth_rx_classify.sv
read_verilog -formal -sv formal_classify.sv
prep -top formal_classify

[files]
../rtl/eth_rx_classify.sv
formal_classify.sv
