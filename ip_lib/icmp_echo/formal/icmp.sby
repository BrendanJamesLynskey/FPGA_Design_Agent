# SymbiYosys: icmp_echo's reply protocol (axi_tx/rtl/axis_rules.sv, the AXI checker). bmc: bounded, depth 64 (a request, a frame right after it and the reply's first bytes); cover: a
# whole reply to a minimal echo request leaves (depth 96; 90 before the 0.2.0 latency).
[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 64
cover: mode cover
cover: depth 96

# yices: the 0.2.0 reply starts later and boolector did not finish step 61 of the bounded check in an hour; yices passes steps 57-63 in about 10 minutes
[engines]
smtbmc yices

[script]
read_verilog -formal -sv axis_rules.sv
read_verilog -formal -sv icmp_echo.sv
read_verilog -formal -sv formal_icmp.sv
prep -top formal_icmp

[files]
../../../axi_tx/rtl/axis_rules.sv
../rtl/icmp_echo.sv
formal_icmp.sv
