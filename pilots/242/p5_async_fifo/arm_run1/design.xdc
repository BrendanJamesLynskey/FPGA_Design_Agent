## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (kr260-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN C3   IOSTANDARD LVCMOS18 } [get_ports { clk_25m }];  # clk_25
create_clock -add -name sys_clk_pin -period 40.00 -waveform {0 20} [get_ports { clk_25m }];
set_property -dict { PACKAGE_PIN F8   IOSTANDARD LVCMOS18 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN E8   IOSTANDARD LVCMOS18 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN Y10  IOSTANDARD LVCMOS33 } [get_ports { sfp_tx_disable }];  # sfp_tx_disable

# rclk: SFP+ MGTREFCLK0 156.25 MHz (6.4 ns). Named rclk to match the clock domain declared in architecture.yaml;
# this replaces the flow's default gt_refclk clock on the same pin.
create_clock -name rclk -period 6.400 [get_ports { gt_refclk_p }];

# usr_cclk (USR_ACCESSE2 internal clock): its DATA word is constant after configuration, so it has no
# timing relation to wclk. No XPM crossing involves this clock, so a clock group does not hide one.
set_clock_groups -asynchronous -group [get_clocks sys_clk_pin] -group [get_clocks usr_cclk]

# wclk power-up reset into the rclk reset synchroniser (reset_sync, 3-flop chain): the reset is held for
# many rclk cycles, so the crossing is a level that needs no setup/hold relation to rclk.
set_false_path -from [get_clocks sys_clk_pin] -to [get_cells {u_core/u_rside/u_rrst/q_reg[*]}]
