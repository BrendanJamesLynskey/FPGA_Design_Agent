## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (kr260-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN C3   IOSTANDARD LVCMOS18 } [get_ports { clk }];  # clk_25
create_clock -add -name sys_clk_pin -period 40.00 -waveform {0 20} [get_ports { clk }];
set_property -dict { PACKAGE_PIN F8   IOSTANDARD LVCMOS18 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN E8   IOSTANDARD LVCMOS18 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN Y10  IOSTANDARD LVCMOS33 } [get_ports { sfp_tx_disable }];  # sfp_tx_disable

# JTAG TCK from the BSCANE2 primitive (no timing arc, so it needs a primary clock); 30 ns is a
# conservative bound for the JTAG cable clock. It is asynchronous to the 25 MHz clock; the
# crossings are xpm_cdc primitives inside jtag_bus.
create_clock -name jtag_tck -period 30.00 [get_pins u_bus/u_bscan/INTERNAL_TCK]
# USR_ACCESSE2 configuration clock pin: the data is static after configuration; 10 ns bound.
create_clock -name usr_cclk -period 10.00 [get_pins u_core/u_usr/CCLK]
# The TCK<->clk crossings are all inside xpm_cdc primitives, which carry their own exceptions.
# The USR_ACCESS value is static after configuration: bound it by one destination period.
set_max_delay -datapath_only -from [get_clocks usr_cclk] -to [get_clocks sys_clk_pin] 40.0

# LEDs and SFP tx-disable are static indicator/control outputs with no external timing
# requirement; a generous output delay constrains them against the 25 MHz clock.
set OUT_PORTS [get_ports {led[*] sfp_tx_disable}]
set_output_delay -clock sys_clk_pin -max 10.0 $OUT_PORTS
set_output_delay -clock sys_clk_pin -min 0.0 $OUT_PORTS
