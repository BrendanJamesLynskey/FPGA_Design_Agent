## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (kr260-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN C3   IOSTANDARD LVCMOS18 } [get_ports { clk_25 }];  # clk_25
create_clock -add -name sys_clk_pin -period 40.00 -waveform {0 20} [get_ports { clk_25 }];
set_property -dict { PACKAGE_PIN F8   IOSTANDARD LVCMOS18 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN E8   IOSTANDARD LVCMOS18 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN Y10  IOSTANDARD LVCMOS33 } [get_ports { sfp_tx_disable }];  # sfp_tx_disable

# LEDs: heartbeat/lock indicators, no timing relationship to any external device;
# output delay is nominal so the ports are constrained, and the paths are false.
set LEDS [get_ports {led[*]}]
set_output_delay -clock [get_clocks sys_clk_pin] 0 $LEDS
set_false_path -to $LEDS

# sfp_tx_disable: static constant 1, no timing relationship; constrained and false-pathed.
set SFPD [get_ports {sfp_tx_disable}]
set_output_delay -clock [get_clocks sys_clk_pin] 0 $SFPD

# JTAG TCK from the BSCANE2 primitive inside jtag_bus: 33 MHz maximum JTAG clock (30 ns);
# TCK to clk crossings are xpm_cdc macros that carry their own max-delay constraints.
# USR_ACCESSE2 reads the configuration register on the internal config clock (up to 100 MHz);
# its DATA is static after configuration. Clock defined on the primitive's CCLK pin.
create_clock -name cfg_cclk -period 10.000 [get_pins u_usr/CCLK]
# cfg_cclk is unrelated to the MMCM clock; BUILD is static after configuration.
set_clock_groups -asynchronous -group [get_clocks cfg_cclk] -group [get_clocks clk_mmcm]

create_clock -name jtag_tck -period 30.000 [get_pins u_jtag/u_bscan/INTERNAL_TCK]
