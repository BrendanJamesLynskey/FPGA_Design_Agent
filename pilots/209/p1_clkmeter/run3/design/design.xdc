## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (kr260-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN C3   IOSTANDARD LVCMOS18 } [get_ports { clk_c3_in }];  # clk_25
create_clock -add -name sys_clk_pin -period 40.00 -waveform {0 20} [get_ports { clk_c3_in }];
set_property -dict { PACKAGE_PIN F8   IOSTANDARD LVCMOS18 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN E8   IOSTANDARD LVCMOS18 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN Y10  IOSTANDARD LVCMOS33 } [get_ports { sfp_tx_disable }];  # sfp_tx_disable

# SFP+ MGTREFCLK0 reference, 156.25 MHz (the ruler): primary clock on the differential input port, it propagates through IBUFDS_GTE4 and BUFG_GT
create_clock -name clk_ref_pin -period 6.40 [get_ports { mgtrefclk0_p }]
# IBUFDS_GTE4 for the SFP+ quad reference clock 0 (GTH quad 224 is the first GTH quad of the xck26; the GTH column is X1 on Zynq UltraScale+, REFCLK0 is site X1Y0)
set_property LOC IBUFDS_GTE4_X1Y6 [get_cells { u_ibufds_gt }]

# BSCANE2 TCK is the JTAG clock (slow, 10 MHz at most); defined on the primitive's internal clock input pin so it is a clock source with no upstream arc
create_clock -name jtag_tck -period 100.00 [get_pins { u_bus/u_bscan/INTERNAL_TCK }]

# The three clocks are unrelated: every crossing goes through an XPM CDC primitive that carries its own
# scoped datapath-only max delay, so no clock-group or false-path exception is added that would override it

# USR_ACCESSE2 CFGCLK is the internal configuration clock (about 50 MHz max); give its pin a clock, unrelated to the others
create_clock -name cfg_clk -period 20.00 [get_pins { u_core/u_usr/CCLK }]
set_clock_groups -asynchronous -group [get_clocks cfg_clk] -group [get_clocks { sys_clk_pin clk_ref_pin jtag_tck }]

# BSCANE2 TDO is a shift-register output that goes to the JTAG cable, timed against the slow TCK
set_max_delay -from [get_clocks jtag_tck] -to [get_pins { u_bus/u_bscan/TDO }] 50.00

# LEDs and tx_disable are slow human-visible outputs with no timing relationship to a board clock
set LED_PORTS [get_ports { led[*] sfp_tx_disable }]
set_output_delay -clock [get_clocks sys_clk_pin] 0.0 $LED_PORTS
set_false_path -to $LED_PORTS

# h_* are spec-declared register-port names; the real bus is internal (jtag_bus), so the top ports are never timed
set H_IN [get_ports { h_we h_re h_addr[*] h_wdata[*] }]
set_input_delay -clock [get_clocks sys_clk_pin] 0.0 $H_IN
set H_OUT [get_ports { h_rdata[*] }]
set_output_delay -clock [get_clocks sys_clk_pin] 0.0 $H_OUT
