## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (kr260-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN C3   IOSTANDARD LVCMOS18 } [get_ports { clk25 }];  # clk_25
create_clock -add -name sys_clk_pin -period 40.00 -waveform {0 20} [get_ports { clk25 }];
set_property -dict { PACKAGE_PIN F8   IOSTANDARD LVCMOS18 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN E8   IOSTANDARD LVCMOS18 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN Y10  IOSTANDARD LVCMOS33 } [get_ports { sfp_tx_disable }];  # sfp_tx_disable

# usr_cclk is the USR_ACCESSE2 CCLK output (internal configuration clock, unrelated to clk25).
# The core only samples the static BUILD word it carries; clk25 and its MMCM output are a separate primary clock.
set_clock_groups -asynchronous -group [get_clocks usr_cclk] -group [get_clocks -include_generated_clocks sys_clk_pin]
