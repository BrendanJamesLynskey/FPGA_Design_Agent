## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (kr260-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN C3   IOSTANDARD LVCMOS18 } [get_ports { clk_c3 }];  # clk_25
create_clock -add -name sys_clk_pin -period 40.00 -waveform {0 20} [get_ports { clk_c3 }];
set_property -dict { PACKAGE_PIN F8   IOSTANDARD LVCMOS18 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN E8   IOSTANDARD LVCMOS18 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN Y10  IOSTANDARD LVCMOS33 } [get_ports { sfp_tx_disable }];  # sfp_tx_disable

# SFP+ MGTREFCLK0, 156.25 MHz (6.4 ns) reader clock, defined on the input port of the IBUFDS_GTE4 (a proper primary clock source); its ODIV2 output drives the reader BUFG_GT.
# The crossings are xpm_cdc/xpm_fifo primitives, which carry their own scoped datapath-only max-delay exceptions.
create_clock -name clk_gt156 -period 6.400 [get_ports { gt_refclk_p }]

# jtag_bus BSCANE2 internal TCK (USER4 chain), clocks the TCK-side registers; 50 ns is an upper bound on the JTAG cable clock.
create_clock -name jtag_tck -period 50.000 [get_pins { u_bus/u_bscan/INTERNAL_TCK }]

# USR_ACCESSE2 CCLK pin only exposes a static word, no timed data path: 50 ns bound on the configuration clock.
create_clock -name usr_cclk -period 50.000 [get_pins { u_core/u_usr/CCLK }]



# The reference clock buffer sits in the GTH quad 224 (SFP+ cage MGTREFCLK0): site IBUFDS_GTE4_X0Y0 (refclk0 of the only quad).
set_property LOC IBUFDS_GTE4_X0Y0 [get_cells { u_ibufds_gt }]

# LEDs drive a human indicator with no data-sheet timing (no tCO, tSU, trace or skew terms apply): zero delay and false path
set LEDS [get_ports { led[*] }]
set_output_delay -clock [get_clocks sys_clk_pin] 0.0 $LEDS
set_false_path -to $LEDS

# sfp_tx_disable is a constant 1 level (no tCO, tSU, trace or skew terms apply): zero delay, no false path (a constant has no timing path)
set TXD [get_ports { sfp_tx_disable }]
set_output_delay -clock [get_clocks sys_clk_pin] 0.0 $TXD

# h_rdata is the internal register-port read data (no board pin, no tCO, tSU, trace or skew terms): zero delay and false path
set HRD [get_ports { h_rdata[*] }]
set_output_delay -clock [get_clocks sys_clk_pin] 0.0 $HRD
set_false_path -to $HRD
