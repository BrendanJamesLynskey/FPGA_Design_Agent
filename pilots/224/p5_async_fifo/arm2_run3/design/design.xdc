## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (kr260-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN C3   IOSTANDARD LVCMOS18 } [get_ports { clk_25 }];  # clk_25
create_clock -add -name sys_clk_pin -period 40.00 -waveform {0 20} [get_ports { clk_25 }];
set_property -dict { PACKAGE_PIN F8   IOSTANDARD LVCMOS18 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN E8   IOSTANDARD LVCMOS18 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN Y10  IOSTANDARD LVCMOS33 } [get_ports { sfp_tx_disable }];  # sfp_tx_disable

# SFP+ MGTREFCLK0 (quad 224) differential reference pair; the pins are fixed by the GT quad.
set_property PACKAGE_PIN Y6 [get_ports gt_refclk_p]
set_property PACKAGE_PIN Y5 [get_ports gt_refclk_n]

# Reader clock: 156.25 MHz (6.4 ns) primary clock at the output of the reference buffer.
create_clock -name gt_refclk -period 6.400 [get_nets gt_refclk_p]

# Internal configuration clock of USR_ACCESSE2 (undriven pin, up to 50 MHz); only read as a static word.
create_clock -name usr_cclk -period 20.000 [get_pins u_core/u_core/u_usr/CCLK]

# JTAG TCK from the BSCANE2 inside jtag_bus (user chain 4); the cable runs at most 30 MHz, 33.3 ns.
create_clock -name jtag_tck -period 33.334 [get_pins u_bus/u_bscan/INTERNAL_TCK]

# clk_25, gt_refclk and jtag_tck are unrelated; all crossings are CDC primitives.
set_clock_groups -asynchronous -group [get_clocks jtag_tck] -group [get_clocks sys_clk_pin]
set_clock_groups -asynchronous -group [get_clocks usr_cclk] -group [get_clocks sys_clk_pin]
# The XPM CDC primitives carry their own datapath-only max delays, which override the group;
# bound the remaining clk_25 -> gt_refclk crossings explicitly to one reader period.
set_max_delay -datapath_only -from [get_clocks sys_clk_pin] -to [get_clocks gt_refclk] 6.400

# LEDs and sfp_tx_disable are static status outputs with no external timing requirement;
# output delays only make them constrained endpoints.
set STATUS_OUT [get_ports {led[*] sfp_tx_disable}]
set_output_delay -clock [get_clocks sys_clk_pin] -max 2.0 $STATUS_OUT
set_output_delay -clock [get_clocks sys_clk_pin] -min -1.0 $STATUS_OUT
