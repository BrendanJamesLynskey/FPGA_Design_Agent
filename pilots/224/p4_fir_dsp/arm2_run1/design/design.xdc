## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (kr260-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN C3   IOSTANDARD LVCMOS18 } [get_ports { clk_25 }];  # clk_25
create_clock -add -name sys_clk_pin -period 40.00 -waveform {0 20} [get_ports { clk_25 }];
set_property -dict { PACKAGE_PIN F8   IOSTANDARD LVCMOS18 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN E8   IOSTANDARD LVCMOS18 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN Y10  IOSTANDARD LVCMOS33 } [get_ports { sfp_tx_disable }];  # sfp_tx_disable

# JTAG TCK from BSCANE2 (USER4): a clock source inside the device, 10 MHz max typical; without it the
# jtag_bus TCK-domain registers have no clock. Its crossings into clk_25 are all xpm_cdc primitives.
create_clock -name jtag_tck -period 100.00 [get_pins u_jtag/u_bscan/INTERNAL_TCK]

# Reset synchroniser: the asynchronous assert into xpm_cdc_async_rst crosses from clk_25 to clk_dp by design
# (asynchronous assert, synchronous release), so its PRE pins are not timed.
set_false_path -to [get_pins -quiet -hierarchical -filter {REF_PIN_NAME == PRE && NAME =~ u_rst/u_rst_dp/*}]
# Configuration/JTAG primitive pins with no user clock (USR_ACCESSE2 CCLK, BSCANE2 INTERNAL_TCK and TDO):
# static build word and JTAG shift data that are crossed with xpm_cdc primitives, so not timed here.
set_false_path -to [get_pins -quiet {u_core/u_fir_core/u_usr/CCLK u_jtag/u_bscan/INTERNAL_TCK u_jtag/u_bscan/TDO}]
# These two pins have no clock in the synthesised netlist; give them the clocks they carry (config clock
# ~ up to 100 MHz for CCLK, JTAG TCK for INTERNAL_TCK) so check_timing sees a clock; groups keep them untimed against others.
create_clock -name usr_cclk -period 10.00 [get_pins u_core/u_fir_core/u_usr/CCLK]
set_clock_groups -asynchronous -group [get_clocks usr_cclk] -group [get_clocks jtag_tck] -group [get_clocks sys_clk_pin]

# LEDs and sfp_tx_disable are static / human-visible outputs, not timing relevant: zero output delay
# against the board clock and a false path.
set slow_out [get_ports {led[*] sfp_tx_disable}]
set_output_delay -clock sys_clk_pin 0.000 $slow_out
set_false_path -to $slow_out
