## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (kr260-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN C3   IOSTANDARD LVCMOS18 } [get_ports { clk_25 }];  # clk_25
create_clock -add -name sys_clk_pin -period 40.00 -waveform {0 20} [get_ports { clk_25 }];
set_property -dict { PACKAGE_PIN F8   IOSTANDARD LVCMOS18 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN E8   IOSTANDARD LVCMOS18 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN Y10  IOSTANDARD LVCMOS33 } [get_ports { sfp_tx_disable }];  # sfp_tx_disable

# The JTAG TCK comes from the BSCANE2 primitive inside jtag_bus; the cable runs at most 30 MHz,
# so a 33 ns clock gives the TCK-domain registers a timed clock (FDA-CON-5).
create_clock -name jtag_tck -period 33.000 [get_pins u_bus/u_bscan/INTERNAL_TCK]
# The configuration clock inside USR_ACCESSE2 (build-stamp read) is slow and only read through a synchroniser (FDA-CON-5).
create_clock -name usr_cclk -period 20.000 [get_pins u_core/u_usr/CCLK]
# TDO goes to the JTAG cable's own TDO pin, outside the fabric's timing scope (FDA-CON-5).
set_false_path -to [get_pins u_bus/u_bscan/TDO]
# The LEDs and the SFP disable are slow outputs with no external device clocking them. Output delay =
# trace skew 0.5 ns + data-valid window/tSU of 9.5 ns for a 40 ns period, so the 10 ns max and
# 0 ns min (tH 0, trace 0) leave the board path timed with margin (FDA-CON-5).
set_output_delay -clock [get_clocks sys_clk_pin] -max 10.000 [get_ports {led[*] sfp_tx_disable}]
set_output_delay -clock [get_clocks sys_clk_pin] -min 0.000 [get_ports {led[*] sfp_tx_disable}]
# The power-on reset enters the clk_dsp reset synchroniser (xpm_cdc_async_rst) at its asynchronous PRE pins; assertion is
# asynchronous by design and release is synchronised, so the 25 MHz to 250 MHz path is not timed (FDA-CON-5).
set_false_path -from [get_cells u_rst/rst_reg] -to [get_pins {u_core/u_rst_dsp/arststages_ff_reg[*]/PRE}]
# TCK and the board/datapath clocks are asynchronous; jtag_bus crosses only through xpm_cdc synchronisers (FDA-CON-5).
set_clock_groups -asynchronous -group [get_clocks jtag_tck] -group [get_clocks usr_cclk] -group [get_clocks {sys_clk_pin clk_dsp_raw clk_fb}]

