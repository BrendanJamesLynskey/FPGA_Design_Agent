# PROPOSED, NOT ENABLED (brief 143d): weekly, Sunday night, so the hour-long xsim run and the Vivado build do not meet the owner's day or the board sessions.
[Unit]
Description=Weekly local fresh-evidence run (FPGA Design Agent)

[Timer]
OnCalendar=Sun *-*-* 22:00:00
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
