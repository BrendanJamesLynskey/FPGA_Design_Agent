# Pins of the Nexys A7-100T (from boards/nexys_a7_100t/Nexys-A7-100T-Master.xdc): clk E3, CPU_RESETN C12, SW0-4 J15 L16 M13 R15 R17, LED0-7.
set_property -dict {PACKAGE_PIN E3  IOSTANDARD LVCMOS33} [get_ports clk]
set_property -dict {PACKAGE_PIN C12 IOSTANDARD LVCMOS33} [get_ports rst_n]
set_property -dict {PACKAGE_PIN J15 IOSTANDARD LVCMOS33} [get_ports cmd_valid]
set_property -dict {PACKAGE_PIN L16 IOSTANDARD LVCMOS33} [get_ports gnt]
set_property -dict {PACKAGE_PIN M13 IOSTANDARD LVCMOS33} [get_ports ack]
set_property -dict {PACKAGE_PIN R15 IOSTANDARD LVCMOS33} [get_ports nack]
set_property -dict {PACKAGE_PIN R17 IOSTANDARD LVCMOS33} [get_ports rsp_ready]
set_property -dict {PACKAGE_PIN H17 IOSTANDARD LVCMOS33} [get_ports cmd_ready]
set_property -dict {PACKAGE_PIN K15 IOSTANDARD LVCMOS33} [get_ports cmd_ack]
set_property -dict {PACKAGE_PIN J13 IOSTANDARD LVCMOS33} [get_ports bus_req]
set_property -dict {PACKAGE_PIN N14 IOSTANDARD LVCMOS33} [get_ports bus_addr_v]
set_property -dict {PACKAGE_PIN R18 IOSTANDARD LVCMOS33} [get_ports bus_valid]
set_property -dict {PACKAGE_PIN V17 IOSTANDARD LVCMOS33} [get_ports bus_last]
set_property -dict {PACKAGE_PIN U17 IOSTANDARD LVCMOS33} [get_ports rsp_valid]
set_property -dict {PACKAGE_PIN U16 IOSTANDARD LVCMOS33} [get_ports rsp_err]
create_clock -name clk -period 10.0 [get_ports clk]
set_input_delay  -clock clk -max 4.0 [get_ports {cmd_valid gnt ack nack rsp_ready rst_n}]
set_input_delay  -clock clk -min 1.0 [get_ports {cmd_valid gnt ack nack rsp_ready rst_n}]
set_output_delay -clock clk -max 4.0 [get_ports {cmd_ready cmd_ack bus_req bus_addr_v bus_valid bus_last rsp_valid rsp_err}]
set_output_delay -clock clk -min -1.0 [get_ports {cmd_ready cmd_ack bus_req bus_addr_v bus_valid bus_last rsp_valid rsp_err}]
