# SymbiYosys: the transmit frame FSM of mac_tx.sv (brief 58A step 0).
[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 40
cover: mode cover
cover: depth 50

[engines]
smtbmc z3

[script]
read_verilog -formal -sv eth_crc32_free.sv
read_verilog -formal -sv mac_tx.sv
read_verilog -formal -sv formal_mac_tx.sv
prep -top formal_mac_tx

[files]
eth_crc32_free.sv
../../../../ip_lib/eth_mac_rgmii/rtl/mac_tx.sv
formal_mac_tx.sv
