`verilator_config
// designs/b96_kr260_10g/rm_gp_itch: lint-only configuration (tests/test_b127_lint.py). The packages list every index a build might use; the 96 design's package keeps functions only some builds call.
lint_off -rule UNUSEDPARAM -file "*itch_pkg2.sv"
lint_off -rule UNUSEDPARAM -file "*itch_pkg.sv"
lint_off -rule UNUSEDPARAM -file "*b96_pkg.sv"
lint_off -rule UNUSEDSIGNAL -file "*b96_pkg.sv"
// brief 191: risk_glue gained observation outputs (vd_v, vd_pass, vd_rej, rej_seen) that this top does not use; left unconnected on purpose.
lint_off -rule PINCONNECTEMPTY -file "*itch_top.sv"
