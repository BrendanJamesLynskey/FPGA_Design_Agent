# SymbiYosys: rate_match_gp (brief 115), two free clocks (multiclock on), properties bound from rm_gp_props.sv.
#   safety_bmc / safety_prove : P1..P9 (overflow, underflow, pointer views, gray, idle policy, integrity of the symbolic entry); prove = k-induction
#   progress_bmc / progress_prove : P10, bounded response, lock high and no reset
#   progress_pdr / safety_pdr : the same properties by IC3/PDR (abc pdr, brief 191): it finds its own strengthening invariants, so it can close what k-induction cannot (the progress ranking function)
#   cover : the proofs are not vacuous
# Run: sby -f rm_gp.sby <task>      (OSS CAD Suite 2026-11-12; see run_formal.py, which also runs the mutants)
[tasks]
safety_bmc safety bmc
safety_prove safety prove
progress_bmc progress bmc
progress_prove progress prove
progress_pdr progress prove
safety_pdr safety prove
cover safety cover

[options]
multiclock on
bmc: mode bmc
bmc: depth 40
prove: mode prove
prove: depth 24
progress_pdr: mode prove
safety_pdr: mode prove
cover: mode cover
cover: depth 60

[engines]
safety_bmc: smtbmc boolector
safety_prove: smtbmc boolector
progress_bmc: smtbmc boolector
progress_prove: smtbmc boolector
cover: smtbmc boolector
progress_pdr: abc pdr
safety_pdr: abc pdr

[script]
plugin -i slang
safety: read_slang --top rm_gp_fv_top -G AW=2 -D FV_KB=0 xpm_formal.sv rate_match_gp.sv rm_gp_props.sv rm_gp_bind.sv rm_gp_fv_top.sv
progress: read_slang --top rm_gp_fv_top -G AW=2 -D FV_KB=0 -D FV_PROGRESS xpm_formal.sv rate_match_gp.sv rm_gp_props.sv rm_gp_bind.sv rm_gp_fv_top.sv
prep -top rm_gp_fv_top

[files]
xpm_formal.sv
../../rtl/rate_match_gp.sv
rm_gp_props.sv
rm_gp_bind.sv
rm_gp_fv_top.sv
