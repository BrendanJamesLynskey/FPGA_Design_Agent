# SymbiYosys: bounded proof, k-induction proof and cover of sevenseg_scan.sv against scan_checker.sv.
# Rigour (brief 143c): see scan.rigour.yaml (assertion/cover pairing, depth justification).
# req: REQ-04
[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 40
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 40

[engines]
smtbmc z3

[script]
read_verilog -formal -sv sevenseg_scan.sv
read_verilog -formal -sv -DFORMAL v_macros.svh v_macros_paired.svh scan_checker.sv
read_verilog -formal -sv -DFORMAL formal_scan.sv
prep -top formal_scan

[files]
../../rtl/sevenseg_scan.sv
../checkers/v_macros.svh
v_macros_paired.svh
../checkers/scan_checker.sv
formal_scan.sv
