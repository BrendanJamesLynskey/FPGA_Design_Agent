# ibert_top.xdc (brief 56A probe): pins of the four bonded GTH channels of quad 224, the reference and a 25 MHz system clock for the IBERT wrapper
set_property -dict {PACKAGE_PIN C3 IOSTANDARD LVCMOS18} [get_ports clk_25]
create_clock -name clk_25 -period 40.000 [get_ports clk_25]
set_property PACKAGE_PIN Y6 [get_ports refclk_p]
set_property PACKAGE_PIN Y5 [get_ports refclk_n]
create_clock -name refclk -period 6.400 [get_ports refclk_p]
set_property PACKAGE_PIN Y2 [get_ports {rxp[0]}]
set_property PACKAGE_PIN Y1 [get_ports {rxn[0]}]
set_property PACKAGE_PIN W4 [get_ports {txp[0]}]
set_property PACKAGE_PIN W3 [get_ports {txn[0]}]
set_property PACKAGE_PIN V2 [get_ports {rxp[1]}]
set_property PACKAGE_PIN V1 [get_ports {rxn[1]}]
set_property PACKAGE_PIN U4 [get_ports {txp[1]}]
set_property PACKAGE_PIN U3 [get_ports {txn[1]}]
set_property PACKAGE_PIN T2 [get_ports {rxp[2]}]
set_property PACKAGE_PIN T1 [get_ports {rxn[2]}]
set_property PACKAGE_PIN R4 [get_ports {txp[2]}]
set_property PACKAGE_PIN R3 [get_ports {txn[2]}]
set_property PACKAGE_PIN P2 [get_ports {rxp[3]}]
set_property PACKAGE_PIN P1 [get_ports {rxn[3]}]
set_property PACKAGE_PIN N4 [get_ports {txp[3]}]
set_property PACKAGE_PIN N3 [get_ports {txn[3]}]
