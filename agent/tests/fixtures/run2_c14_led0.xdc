## design.xdc: generated by the core's board_constraints tool from the board's master XDC
## (Nexys-A7-100T-Master.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN E3   IOSTANDARD LVCMOS33 } [get_ports { CLK100MHZ }];  # CLK100MHZ
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { CLK100MHZ }];
set_property -dict { PACKAGE_PIN C12  IOSTANDARD LVCMOS33 } [get_ports { CPU_RESETN }];  # CPU_RESETN
set_property -dict { PACKAGE_PIN H17  IOSTANDARD LVCMOS33 } [get_ports { LED0 }];  # LED[0]
set_property -dict { PACKAGE_PIN D4   IOSTANDARD LVCMOS33 } [get_ports { UART_RXD_OUT }];  # UART_RXD_OUT
set_property -dict { PACKAGE_PIN C4   IOSTANDARD LVCMOS33 } [get_ports { UART_TXD_IN }];  # UART_TXD_IN

# FDA-CON-5: CPU_RESETN and UART_TXD_IN are asynchronous external inputs (button / host UART),
# synchronised inside the design; zero input delay so analysis constrains them, and a false
# path because no board-level timing relationship to the clock exists.
set RST_IN [get_ports { CPU_RESETN }]
set UART_IN [get_ports { UART_TXD_IN }]
set_input_delay -clock sys_clk_pin -max 0.0 $RST_IN
set_input_delay -clock sys_clk_pin -min 0.0 $RST_IN
set_input_delay -clock sys_clk_pin -max 0.0 $UART_IN
set_input_delay -clock sys_clk_pin -min 0.0 $UART_IN
set_false_path -from $RST_IN
set_false_path -from $UART_IN

# FDA-CON-5: UART_RXD_OUT (115200 baud, ~8680 ns/bit) and LED0 (status LED) are slow outputs
# with no synchronous capture device; zero output delay plus a false path, since the clock
# insertion delay plus OBUF delay alone exceeds one 10 ns period and timing is irrelevant here.
set UART_OUT [get_ports { UART_RXD_OUT }]
set LED_OUT [get_ports { LED0 }]
set_output_delay -clock sys_clk_pin -max 0.0 $UART_OUT
set_output_delay -clock sys_clk_pin -min 0.0 $UART_OUT
set_output_delay -clock sys_clk_pin -max 0.0 $LED_OUT
set_output_delay -clock sys_clk_pin -min 0.0 $LED_OUT
set_false_path -to $UART_OUT
set_false_path -to $LED_OUT

set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
