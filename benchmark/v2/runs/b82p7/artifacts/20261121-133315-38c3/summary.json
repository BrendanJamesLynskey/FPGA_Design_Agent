  "questions": [
   {
    "id": "q1",
    "text": "What is the register map of the test shell (offset, width, reset value and access of every register)?",
    "default": "32-bit registers at 0x00 SHELL_ID, 0x04 TICK, 0x08 STATUS, 0x0C REPLY_LEN, 0x10 REPLY_WORD_IDX, 0x14 REPLY_WORD, 0x18 TELE_LEN, 0x1C TELE_WORD_IDX, 0x20 TELE_WORD, 0x24 TELE_TAKE, 0x28 PACKET_BYTE, as in registers.map",
    "reason": "The request names shell registers but gives no offsets, so the map is a proposal.",
    "answer": "IN: offset 0x00, WO, reset 0: [7:0] packet byte, [8] end flag\nSTAT: offset 0x09, RO, reset 0: [0] telemetry on, [1] busy\nRIDX: offset 0x03, RW, reset 0: [6:0] word number\nRWORD: offset 0x04, RO, reset 0: bytes 4i..4i+3 of the reply, first byte on top, zero past the end\nRLEN: offset 0x02, RO, reset 0: length in bytes of the latest reply, 0 if none\nTICK: offset 0x01, WO, reset 0: [7:0] n ticks\nTIDX: offset 0x06, RW, reset 0: [6:0] word number\nTWORD: offset 0x07, RO, reset 0: same for the telemetry frame\nTAKE: offset 0x08, WO, reset 0: any write takes the held telemetry frame\nTLEN: offset 0x05, RO, reset 0: length of the held telemetry frame, 0 if none\nshell: test shell, PROTOCOL.md 1.1\nunmapped: no register at an offset: reads 0, writes ignored (read-only registers behave the same on write)",
    "status": "answered",
    "by": "oracle",
    "evidence": "IN: offset 0x00, WO, reset 0: [7:0] packet byte, [8] end flag"
   },
   {
    "id": "q2",
    "text": "How is the last flag of a payload byte given through the shell?",
    "default": "Bit 8 of the PACKET_BYTE write.",
    "reason": "Not stated.",
    "answer": "Through the IN register at offset 0 (WO). Bits [7:0] carry the packet byte and bit 8 is the end flag. The spec does not use the name PACKET_BYTE, so the proposed default is correct on the bit but should refer to IN.",
    "status": "answered",
    "by": "oracle",
    "evidence": "bits: '[7:0] packet byte, [8] end flag'"
