    "text": "Which packets count in the register-5 refused count when they fail at status 1 to 5?",
    "default": "Every refused packet, with or without reply, counts once",
    "reason": "Request says refused of any kind",
    "answer": "Every refused packet, with or without reply, counts once",
    "status": "defaulted",
    "by": "oracle",
    "evidence": null
   },
   {
    "id": "q4",
    "text": "What happens when TICK is written while earlier ticks are pending?",
    "default": "The new n replaces the pending count",
    "reason": "Request does not say",
    "answer": "The new n replaces the pending count",
    "status": "defaulted",
    "by": "oracle",
