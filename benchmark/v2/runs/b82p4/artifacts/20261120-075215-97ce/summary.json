  "questions": [
   {
    "id": "q1",
    "text": "What is the register map of the test shell (offset, width, reset value and access of every register)?",
    "default": "The map in registers.map: PKT_BYTE 0x00, TICK 0x04, STATUS 0x08, REPLY_LEN 0x0C, REPLY_IDX 0x10, REPLY_WORD 0x14, TELEM_LEN 0x18, TELEM_IDX 0x1C, TELEM_WORD 0x20, TAKE 0x24, all 32 bits.",
    "reason": "The request names shell registers but gives no offsets, so the map is proposed, not known.",
    "answer": "IN: offset 0x00, WO, reset 0: [7:0] packet byte, [8] end flag\nSTAT: offset 0x09, RO, reset 0: [0] telemetry on, [1] busy\nRIDX: offset 0x03, RW, reset 0: [6:0] word number\nRWORD: offset 0x04, RO, reset 0: bytes 4i..4i+3 of the reply, first byte on top, zero past the end\nRLEN: offset 0x02, RO, reset 0: length in bytes of the latest reply, 0 if none\nTICK: offset 0x01, WO, reset 0: [7:0] n ticks\nTIDX: offset 0x06, RW, reset 0: [6:0] word number\nTWORD: offset 0x07, RO, reset 0: same for the telemetry frame\nTAKE: offset 0x08, WO, reset 0: any write takes the held telemetry frame\nTLEN: offset 0x05, RO, reset 0: length of the held telemetry frame, 0 if none\nshell: test shell, PROTOCOL.md 1.1\nunmapped: no register at an offset: reads 0, writes ignored (read-only registers behave the same on write)",
    "status": "answered",
    "by": "oracle",
    "evidence": "IN: offset 0x00, WO, reset 0: [7:0] packet byte, [8] end flag"
   },
   {
    "id": "q2",
    "text": "How does the host give the last-byte flag?",
    "default": "Bit 8 of PKT_BYTE.",
    "reason": "The request says a flag on the last byte but not how the shell carries it.",
    "answer": "Bit 8 of a write to register IN (offset 0x00), with the packet byte in bits [7:0]. The spec names this register IN, not PKT_BYTE, so the proposed default's name does not match the spec.",
    "status": "answered",
    "by": "oracle",
    "evidence": "bits: '[7:0] packet byte, [8] end flag'"
   },
   {
    "id": "q3",
    "text": "Does a refused telemetry start change the period?",
    "default": "No, refused packets change nothing.",
    "reason": "Refusals never change state.",
    "answer": "No. A refused packet changes no telemetry state, and the period belongs to the telemetry pacer, so a refused TLM_START leaves the period unchanged.",
    "status": "answered",
    "by": "oracle",
    "evidence": "a refused packet changes no register, sequence or telemetry state"
   },
   {
    "id": "q4",
    "text": "What are the values of TIMEOUT_CYCLES and BUILD_STAMP?",
