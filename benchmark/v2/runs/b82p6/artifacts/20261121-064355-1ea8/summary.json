  "questions": [
   {
    "id": "q1",
    "text": "What is the register map of the test shell (offset, width, reset value and access of every register)?",
    "default": "RX_BYTE 0x00, TICK 0x04, TAKE 0x08, REPLY_LEN 0x0C, REPLY_IDX 0x10, REPLY_WORD 0x14, TELEM_LEN 0x18, TELEM_IDX 0x1C, TELEM_WORD 0x20, STATUS 0x24, all 32 bits wide, as in registers.map",
    "reason": "The request names these registers but gives no offsets.",
    "answer": "IN: offset 0x00, WO, reset 0: [7:0] packet byte, [8] end flag\nSTAT: offset 0x09, RO, reset 0: [0] telemetry on, [1] busy\nRIDX: offset 0x03, RW, reset 0: [6:0] word number\nRWORD: offset 0x04, RO, reset 0: bytes 4i..4i+3 of the reply, first byte on top, zero past the end\nRLEN: offset 0x02, RO, reset 0: length in bytes of the latest reply, 0 if none\nTICK: offset 0x01, WO, reset 0: [7:0] n ticks\nTIDX: offset 0x06, RW, reset 0: [6:0] word number\nTWORD: offset 0x07, RO, reset 0: same for the telemetry frame\nTAKE: offset 0x08, WO, reset 0: any write takes the held telemetry frame\nTLEN: offset 0x05, RO, reset 0: length of the held telemetry frame, 0 if none\nshell: test shell, PROTOCOL.md 1.1\nunmapped: no register at an offset: reads 0, writes ignored (read-only registers behave the same on write)",
    "status": "answered",
    "by": "oracle",
    "evidence": "IN: offset 0x00, WO, reset 0: [7:0] packet byte, [8] end flag"
   },
   {
    "id": "q2",
    "text": "Does a status command count as carried out, and does telemetry start or stop count?",
    "default": "Yes for every command that gets status 0, counted after its reply is built",
    "reason": "The request says commands carried out but not which ones.",
    "answer": "Yes for every command that gets status 0, counted after its reply is built",
    "status": "defaulted",
    "by": "oracle",
    "evidence": null
   },
   {
    "id": "q3",
    "text": "Which counter takes a status-4 refusal, repeated or out-of-order?",
    "default": "Number equal to the last accepted goes to repeated, any other old number to out-of-order",
    "reason": "The request does not define the split.",
    "answer": "Number equal to the last accepted goes to repeated, any other old number to out-of-order",
    "status": "defaulted",
    "by": "oracle",
    "evidence": null
   },
   {
    "id": "q4",
    "text": "Does a telemetry start with a period of 1 to 3 set 4, and is the period register 6 changed when period is zero?",
    "default": "Period 1 to 3 sets 4, zero leaves register 6 unchanged",
    "reason": "Follows the request text.",
    "answer": "Partly settled. A period of 1 to 3 is raised to 4, and a period of 0 keeps the current period. The spec does not say that register 6 holds the period or that it changes when the period is zero. Register 6 is TIDX, the telemetry word index, and the spec never links it to the period. Whether register 6 changes on a zero period is not specified.",
    "status": "answered",
    "by": "oracle",
    "evidence": "Pacer: TLM_START restarts the count (period 0 keeps, below 4 raised to 4); a frame falls due every period ticks; one held frame; overruns dropped; STOP forgets the held frame; TAKE releases it."
   },
