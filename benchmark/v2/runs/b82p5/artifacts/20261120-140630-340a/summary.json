  "questions": [
   {
    "id": "q1",
    "text": "What is the shell register map (offset, width, reset value and access of every register)?",
    "default": "As in registers.map: DESIGN_ID 0x00, PKT_DATA 0x04, TICK 0x08, STATUS 0x0C, REPLY_LEN 0x10, REPLY_IDX 0x14, REPLY_WORD 0x18, TELE_LEN 0x1C, TELE_IDX 0x20, TELE_WORD 0x24, TAKE 0x28, all 32-bit.",
    "reason": "The request names shell registers but gives no offsets.",
    "answer": "IN: offset 0x00, WO, reset 0: [7:0] packet byte, [8] end flag\nSTAT: offset 0x09, RO, reset 0: [0] telemetry on, [1] busy\nRIDX: offset 0x03, RW, reset 0: [6:0] word number\nRWORD: offset 0x04, RO, reset 0: bytes 4i..4i+3 of the reply, first byte on top, zero past the end\nRLEN: offset 0x02, RO, reset 0: length in bytes of the latest reply, 0 if none\nTICK: offset 0x01, WO, reset 0: [7:0] n ticks\nTIDX: offset 0x06, RW, reset 0: [6:0] word number\nTWORD: offset 0x07, RO, reset 0: same for the telemetry frame\nTAKE: offset 0x08, WO, reset 0: any write takes the held telemetry frame\nTLEN: offset 0x05, RO, reset 0: length of the held telemetry frame, 0 if none\nshell: test shell, PROTOCOL.md 1.1\nunmapped: no register at an offset: reads 0, writes ignored (read-only registers behave the same on write)",
    "status": "answered",
    "by": "oracle",
    "evidence": "IN: offset 0x00, WO, reset 0: [7:0] packet byte, [8] end flag"
   },
   {
    "id": "q2",
    "text": "The Nexys A7-100T oscillator is 100 MHz but the request says 125 MHz with an 8 ns constraint; which is meant?",
    "default": "Use the 8 ns constraint as written, with CLKS_PER_BIT 1085.",
    "reason": "The request is explicit about 125 MHz.",
    "answer": "The spec settles it as 100 MHz with a 10 ns constraint, not 125 MHz with 8 ns. CLKS_PER_BIT stays 868, so the proposed default of 8 ns with CLKS_PER_BIT 1085 is not supported by the spec.",
    "status": "answered",
    "by": "oracle",
    "evidence": "clock_constraint: 10 ns (100 MHz) on CLK100MHZ"
   },
   {
    "id": "q3",
    "text": "How is the last flag given through the shell?",
    "default": "Bit 8 of PKT_DATA is the last flag.",
    "reason": "Not stated in the request.",
    "answer": "The end flag is bit 8 of register IN at offset 0x00 (write-only). The spec names that register IN, not PKT_DATA, so the proposed default's register name does not match the spec. Bits [7:0] carry the packet byte.",
    "status": "answered",
    "by": "oracle",
    "evidence": "IN: offset 0x00, WO, reset 0: [7:0] packet byte, [8] end flag"
   },
