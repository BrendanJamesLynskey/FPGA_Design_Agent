    "text": "What happens when TICK is written while ticks are still pending?",
    "default": "The new count is added to the pending count, saturating at 65535.",
    "reason": "The request does not say.",
    "answer": "The new count is added to the pending count, saturating at 65535.",
    "status": "defaulted",
    "by": "oracle",
