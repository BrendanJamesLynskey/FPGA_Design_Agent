  "questions": [
   {
    "id": "q1",
    "text": "What is the register map (offset, width, reset value and access of every register)?",
    "default": "ENABLE 0x00 RW, PERIOD_REQ 0x04 RW reset 100, PERIOD_EFF 0x08 RO, STATUS 0x0C RO, FRAME_TOTAL 0x10 RO, OVERRUN_TOTAL 0x14 RO, COUNTER 0x18 RO, TAKE 0x1C WO, TICK 0x20 WO, all 32-bit",
    "reason": "The request names registers but gives no offsets.",
    "answer": "FRAMES: offset 0x06, RO, reset 0: [15:0] frames that fell due and were held, wrapping\nSTAT: offset 0x05, RO, reset 0: [0] a frame waits, [1] enabled\nOVERRUNS: offset 0x07, RO, reset 0: [15:0] frames dropped because one was waiting, wrapping\nREQ: offset 0x01, RW, reset 100: [15:0] period asked for, as written\nTICK: offset 0x03, WO, reset 0: [7:0] n ticks, one per clock; reads 0\nCTRL: offset 0x00, RW, reset 0: [0] enable\nCNT: offset 0x08, RO, reset 0: [15:0] ticks counted towards the next frame\nTAKE: offset 0x04, WO, reset 0: any write takes the waiting frame; reads 0\nEFF: offset 0x02, RO, reset 100: [15:0] period in force\nshell: test shell, PROTOCOL.md 1.1\nunmapped: unlisted offsets: read 0, writes dropped; read-only registers also drop writes",
    "status": "answered",
    "by": "oracle",
    "evidence": "FRAMES: offset 0x06, RO, reset 0: [15:0] frames that fell due and were held, wrapping"
   },
   {
    "id": "q2",
    "text": "Does the PERIOD_EFF read show the period latched for the count in progress, or max(requested, PERIOD_MIN) now?",
    "default": "The value latched for the count in progress (the period actually in force).",
    "reason": "The request says a new request does not disturb the count, so the in-force value changes only at a wrap or enable.",
    "answer": "Yes. The EFF register (the spec's name for the question's PERIOD_EFF) reads the period in force, which is the value latched for the count in progress. A new request does not change it until the next count or a switch-on, so it does not show max(requested, PERIOD_MIN) immediately. Note that the spec names the register EFF at offset 0x02, not PERIOD_EFF.",
    "status": "answered",
    "by": "oracle",
    "evidence": "EFF: offset 0x02, RO, reset 100: [15:0] period in force"
   },
   {
    "id": "q3",
    "text": "When a frame falls due in the same clock as a TAKE, what happens?",
    "default": "The old frame is taken and the new one is held, with no overrun.",
    "reason": "The take empties the slot before the new frame needs it.",
    "answer": "The old frame is taken and the new one is held, with no overrun.",
    "status": "defaulted",
    "by": "oracle",
    "evidence": null
   },
   {
    "id": "q4",
    "text": "Does an enable write of 1 while already 1 restart the count?",
    "default": "No, only a 0 to 1 change restarts.",
    "reason": "The request says switching on starts counting.",
    "answer": "No. Writing 1 while enable is already 1 does nothing, so it does not restart the count. Only a 0-to-1 switch-on clears CNT and reloads EFF from the request.",
    "status": "answered",
    "by": "oracle",
    "evidence": "Switch-on (0 to 1) clears CNT and loads EFF from the request; switch-off clears CNT and the waiting frame; totals persist until reset; writing 1 while on does nothing."
   },
   {
