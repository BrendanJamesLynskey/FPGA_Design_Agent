  "questions": [
   {
    "id": "q1",
    "text": "What is the register map for the test shell (offset, width, reset value and access of every register)?",
    "default": "Offsets as in registers.map: bank at 0x00..0x1C with 4-byte stride, staging and control at 0x20..0x40.",
    "reason": "Request names registers and the shell but gives no offsets.",
    "answer": "REFUSED: offset 0x07, WO, reset 0: any write adds one to ERRS\nTLM: offset 0x08, RO, reset 0: [0] telemetry on\nBANK0..BANK7: offset 0x10, RO, reset 0: the eight registers: ID, SCRATCH0..2, CMDS, ERRS, PERIOD, UPTIME\nP1: offset 0x02, RW, reset 0: [31:0] second parameter\nTICK: offset 0x06, WO, reset 0: [7:0] added to UPTIME\nP0: offset 0x01, RW, reset 0: [15:0] first parameter\nCODE: offset 0x04, RO, reset 0: [2:0] result of the last command: 0 OK, 1 unknown type, 3 unknown register, 5 write to a read-only register\nRDATA: offset 0x05, RO, reset 0: value of the last successful read, else 0\nTYP: offset 0x00, RW, reset 0: [7:0] command type\nGO: offset 0x03, WO, reset 0: any write runs the staged command; reads 0\nunmapped: an unused offset reads zero and a write to it, or to a read-only register, has no effect\nshell: test shell, PROTOCOL.md 1.1",
    "status": "answered",
    "by": "oracle",
    "evidence": "REFUSED: offset 0x07, WO, reset 0: any write adds one to ERRS"
   },
   {
    "id": "q2",
    "text": "Does UPTIME or a counter saturate or wrap at 32 bits?",
    "default": "Wrap modulo 2^32.",
    "reason": "Request is silent; wrap is the cheapest.",
    "answer": "Wrap modulo 2^32.",
