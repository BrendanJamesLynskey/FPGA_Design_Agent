    "text": "If a tick write, a refused write and a command completion occur in the same cycle, how are CMDS/ERRS/UPTIME updated?",
    "default": "All apply; ERRS gets the sum of increments.",
    "reason": "No loss of events is the safest reading.",
    "answer": "All apply; ERRS gets the sum of increments.",
    "status": "defaulted",
    "by": "oracle",
    "evidence": null
   },
   {
    "id": "q4",
    "text": "What are the values of TIMEOUT_CYCLES and BUILD_STAMP?",
    "default": "TIMEOUT_CYCLES 1000000 (10 ms), BUILD_STAMP 0.",
    "reason": "Named as provided but values not given.",
    "answer": "TIMEOUT_CYCLES is 100000, not 1000000 as proposed. BUILD_STAMP is not specified in the spec, so its value cannot be given.",
    "status": "answered",
    "by": "oracle",
    "evidence": "TIMEOUT_CYCLES: 100000"
