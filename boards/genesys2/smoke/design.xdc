## design.xdc: smoke design for the Digilent Genesys 2, generated by tools/board_smoke.py through the core's board_constraints tool from the board's master XDC
## (Genesys-2-Master.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN E18  IOSTANDARD LVCMOS12 } [get_ports { btn }];  # btnc
set_property -dict { PACKAGE_PIN AD12 IOSTANDARD LVDS } [get_ports { clk_p }];  # sysclk_p
set_property -dict { PACKAGE_PIN AD11 IOSTANDARD LVDS } [get_ports { clk_n }];  # sysclk_n
create_clock -add -name sys_clk_pin -period 5.00 -waveform {0 2.5} [get_ports { clk_p }];
set_property -dict { PACKAGE_PIN T28  IOSTANDARD LVCMOS33 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN V19  IOSTANDARD LVCMOS33 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN U30  IOSTANDARD LVCMOS33 } [get_ports { led[2] }];  # led[2]
set_property -dict { PACKAGE_PIN U29  IOSTANDARD LVCMOS33 } [get_ports { led[3] }];  # led[3]
set_property -dict { PACKAGE_PIN V20  IOSTANDARD LVCMOS33 } [get_ports { led[4] }];  # led[4]
set_property -dict { PACKAGE_PIN V26  IOSTANDARD LVCMOS33 } [get_ports { led[5] }];  # led[5]
set_property -dict { PACKAGE_PIN W24  IOSTANDARD LVCMOS33 } [get_ports { led[6] }];  # led[6]
set_property -dict { PACKAGE_PIN W23  IOSTANDARD LVCMOS33 } [get_ports { led[7] }];  # led[7]
set_property -dict { PACKAGE_PIN G19  IOSTANDARD LVCMOS12 } [get_ports { sw[0] }];  # sw[0]
set_property -dict { PACKAGE_PIN G25  IOSTANDARD LVCMOS12 } [get_ports { sw[1] }];  # sw[1]
set_property -dict { PACKAGE_PIN H24  IOSTANDARD LVCMOS12 } [get_ports { sw[2] }];  # sw[2]
set_property -dict { PACKAGE_PIN K19  IOSTANDARD LVCMOS12 } [get_ports { sw[3] }];  # sw[3]
set_property -dict { PACKAGE_PIN N19  IOSTANDARD LVCMOS12 } [get_ports { sw[4] }];  # sw[4]
set_property -dict { PACKAGE_PIN P19  IOSTANDARD LVCMOS12 } [get_ports { sw[5] }];  # sw[5]
set_property -dict { PACKAGE_PIN P26  IOSTANDARD LVCMOS33 } [get_ports { sw[6] }];  # sw[6]
set_property -dict { PACKAGE_PIN P27  IOSTANDARD LVCMOS33 } [get_ports { sw[7] }];  # sw[7]
set_property -dict { PACKAGE_PIN Y20  IOSTANDARD LVCMOS33 } [get_ports { uart_rx }];  # uart_tx_in
set_property -dict { PACKAGE_PIN Y23  IOSTANDARD LVCMOS33 } [get_ports { uart_tx }];  # uart_rx_out

## Configuration bank voltage (unconfirmed for this board: see board.yaml config)
set_property CFGBVS VCCO [current_design];
set_property CONFIG_VOLTAGE 3.3 [current_design];

## Asynchronous inputs: each is synchronised by two ASYNC_REG flops (sync2.sv); a zero input delay marks them
## constrained for check_timing and the false path removes them from timing analysis.
set async_in [get_ports {btn sw[*] uart_rx}]
set_input_delay -clock sys_clk_pin 0.000 $async_in
set_false_path -from $async_in

## Slow outputs: LEDs and the UART transmit line are registered and nothing outside samples them against the clock.
set slow_out [get_ports {led[*] uart_tx}]
set_output_delay -clock sys_clk_pin 0.000 $slow_out
set_false_path -to $slow_out
