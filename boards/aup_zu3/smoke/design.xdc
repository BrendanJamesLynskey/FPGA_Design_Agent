## design.xdc: smoke design for the Real Digital AUP-ZU3, generated by tools/board_smoke.py through the core's board_constraints tool from the board's master XDC
## (aup_zu3-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN AB6  IOSTANDARD LVCMOS12 } [get_ports { btn }];  # btn[0]
set_property -dict { PACKAGE_PIN D6   IOSTANDARD LVDS } [get_ports { clk_n }];  # clk_100_n
set_property -dict { PACKAGE_PIN D7   IOSTANDARD LVDS } [get_ports { clk_p }];  # clk_100_p
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { clk_p }];
set_property -dict { PACKAGE_PIN AF5  IOSTANDARD LVCMOS12 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN AE7  IOSTANDARD LVCMOS12 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN AH2  IOSTANDARD LVCMOS12 } [get_ports { led[2] }];  # led[2]
set_property -dict { PACKAGE_PIN AE5  IOSTANDARD LVCMOS12 } [get_ports { led[3] }];  # led[3]
set_property -dict { PACKAGE_PIN AH1  IOSTANDARD LVCMOS12 } [get_ports { led[4] }];  # led[4]
set_property -dict { PACKAGE_PIN AE4  IOSTANDARD LVCMOS12 } [get_ports { led[5] }];  # led[5]
set_property -dict { PACKAGE_PIN AG1  IOSTANDARD LVCMOS12 } [get_ports { led[6] }];  # led[6]
set_property -dict { PACKAGE_PIN AF2  IOSTANDARD LVCMOS12 } [get_ports { led[7] }];  # led[7]
set_property -dict { PACKAGE_PIN AB1  IOSTANDARD LVCMOS12 } [get_ports { sw[0] }];  # sw[0]
set_property -dict { PACKAGE_PIN AF1  IOSTANDARD LVCMOS12 } [get_ports { sw[1] }];  # sw[1]
set_property -dict { PACKAGE_PIN AE3  IOSTANDARD LVCMOS12 } [get_ports { sw[2] }];  # sw[2]
set_property -dict { PACKAGE_PIN AC2  IOSTANDARD LVCMOS12 } [get_ports { sw[3] }];  # sw[3]
set_property -dict { PACKAGE_PIN AC1  IOSTANDARD LVCMOS12 } [get_ports { sw[4] }];  # sw[4]
set_property -dict { PACKAGE_PIN AD6  IOSTANDARD LVCMOS12 } [get_ports { sw[5] }];  # sw[5]
set_property -dict { PACKAGE_PIN AD1  IOSTANDARD LVCMOS12 } [get_ports { sw[6] }];  # sw[6]
set_property -dict { PACKAGE_PIN AD2  IOSTANDARD LVCMOS12 } [get_ports { sw[7] }];  # sw[7]

## Asynchronous inputs: each is synchronised by two ASYNC_REG flops (sync2.sv); a zero input delay marks them
## constrained for check_timing and the false path removes them from timing analysis.
set async_in [get_ports {btn sw[*]}]
set_input_delay -clock sys_clk_pin 0.000 $async_in
set_false_path -from $async_in

## Slow outputs: LEDs are registered and nothing outside samples them against the clock.
set slow_out [get_ports {led[*]}]
set_output_delay -clock sys_clk_pin 0.000 $slow_out
set_false_path -to $slow_out
