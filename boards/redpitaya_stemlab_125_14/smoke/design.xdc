## design.xdc: smoke design for the Red Pitaya STEMlab 125-14 (original generation, v1.1), generated by tools/board_smoke.py through the core's board_constraints tool from the board's master XDC
## (redpitaya_stemlab_125_14-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN U18  IOSTANDARD DIFF_HSTL_I_18 } [get_ports { clk_p }];  # adc_clk_p
set_property -dict { PACKAGE_PIN U19  IOSTANDARD DIFF_HSTL_I_18 } [get_ports { clk_n }];  # adc_clk_n
create_clock -add -name sys_clk_pin -period 8.00 -waveform {0 4} [get_ports { clk_p }];
set_property -dict { PACKAGE_PIN F16  IOSTANDARD LVCMOS33 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN F17  IOSTANDARD LVCMOS33 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN G15  IOSTANDARD LVCMOS33 } [get_ports { led[2] }];  # led[2]
set_property -dict { PACKAGE_PIN H15  IOSTANDARD LVCMOS33 } [get_ports { led[3] }];  # led[3]
set_property -dict { PACKAGE_PIN K14  IOSTANDARD LVCMOS33 } [get_ports { led[4] }];  # led[4]
set_property -dict { PACKAGE_PIN G14  IOSTANDARD LVCMOS33 } [get_ports { led[5] }];  # led[5]
set_property -dict { PACKAGE_PIN J15  IOSTANDARD LVCMOS33 } [get_ports { led[6] }];  # led[6]
set_property -dict { PACKAGE_PIN J14  IOSTANDARD LVCMOS33 } [get_ports { led[7] }];  # led[7]

## Slow outputs: LEDs are registered and nothing outside samples them against the clock.
set slow_out [get_ports {led[*]}]
set_output_delay -clock sys_clk_pin 0.000 $slow_out
set_false_path -to $slow_out
