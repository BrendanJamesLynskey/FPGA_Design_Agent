## design.xdc: smoke design for the Digilent Cora Z7-10, generated by tools/board_smoke.py through the core's board_constraints tool from the board's master XDC
## (Cora-Z7-10-Master.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN D20  IOSTANDARD LVCMOS33 } [get_ports { btn }];  # btn[0]
set_property -dict { PACKAGE_PIN H16  IOSTANDARD LVCMOS33 } [get_ports { clk }];  # clk
create_clock -add -name sys_clk_pin -period 8.00 -waveform {0 4} [get_ports { clk }];
set_property -dict { PACKAGE_PIN L15  IOSTANDARD LVCMOS33 } [get_ports { led[0] }];  # led0_b
set_property -dict { PACKAGE_PIN G17  IOSTANDARD LVCMOS33 } [get_ports { led[1] }];  # led0_g
set_property -dict { PACKAGE_PIN N15  IOSTANDARD LVCMOS33 } [get_ports { led[2] }];  # led0_r
set_property -dict { PACKAGE_PIN G14  IOSTANDARD LVCMOS33 } [get_ports { led[3] }];  # led1_b
set_property -dict { PACKAGE_PIN L14  IOSTANDARD LVCMOS33 } [get_ports { led[4] }];  # led1_g
set_property -dict { PACKAGE_PIN M15  IOSTANDARD LVCMOS33 } [get_ports { led[5] }];  # led1_r

## Asynchronous inputs: each is synchronised by two ASYNC_REG flops (sync2.sv); a zero input delay marks them
## constrained for check_timing and the false path removes them from timing analysis.
set async_in [get_ports {btn}]
set_input_delay -clock sys_clk_pin 0.000 $async_in
set_false_path -from $async_in

## Slow outputs: LEDs are registered and nothing outside samples them against the clock.
set slow_out [get_ports {led[*]}]
set_output_delay -clock sys_clk_pin 0.000 $slow_out
set_false_path -to $slow_out
