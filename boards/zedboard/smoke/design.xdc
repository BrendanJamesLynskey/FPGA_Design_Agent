## design.xdc: smoke design for the ZedBoard (Avnet and Digilent), generated by tools/board_smoke.py through the core's board_constraints tool from the board's master XDC
## (zedboard-pins.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN Y9   IOSTANDARD LVCMOS33 } [get_ports { clk }];  # GCLK
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { clk }];
set_property -dict { PACKAGE_PIN T22  IOSTANDARD LVCMOS33 } [get_ports { led[0] }];  # LD[0]
set_property -dict { PACKAGE_PIN T21  IOSTANDARD LVCMOS33 } [get_ports { led[1] }];  # LD[1]
set_property -dict { PACKAGE_PIN U22  IOSTANDARD LVCMOS33 } [get_ports { led[2] }];  # LD[2]
set_property -dict { PACKAGE_PIN U21  IOSTANDARD LVCMOS33 } [get_ports { led[3] }];  # LD[3]
set_property -dict { PACKAGE_PIN V22  IOSTANDARD LVCMOS33 } [get_ports { led[4] }];  # LD[4]
set_property -dict { PACKAGE_PIN W22  IOSTANDARD LVCMOS33 } [get_ports { led[5] }];  # LD[5]
set_property -dict { PACKAGE_PIN U19  IOSTANDARD LVCMOS33 } [get_ports { led[6] }];  # LD[6]
set_property -dict { PACKAGE_PIN U14  IOSTANDARD LVCMOS33 } [get_ports { led[7] }];  # LD[7]

## Slow outputs: LEDs are registered and nothing outside samples them against the clock.
set slow_out [get_ports {led[*]}]
set_output_delay -clock sys_clk_pin 0.000 $slow_out
set_false_path -to $slow_out
