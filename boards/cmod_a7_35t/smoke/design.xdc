## design.xdc: smoke design for the Digilent Cmod A7-35T, generated by tools/board_smoke.py through the core's board_constraints tool from the board's master XDC
## (Cmod-A7-Master.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN A18  IOSTANDARD LVCMOS33 } [get_ports { btn }];  # btn[0]
set_property -dict { PACKAGE_PIN L17  IOSTANDARD LVCMOS33 } [get_ports { clk }];  # sysclk
create_clock -add -name sys_clk_pin -period 83.33 -waveform {0 41.6667} [get_ports { clk }];
set_property -dict { PACKAGE_PIN A17  IOSTANDARD LVCMOS33 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN C16  IOSTANDARD LVCMOS33 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN J17  IOSTANDARD LVCMOS33 } [get_ports { uart_rx }];  # uart_txd_in
set_property -dict { PACKAGE_PIN J18  IOSTANDARD LVCMOS33 } [get_ports { uart_tx }];  # uart_rxd_out

## Configuration bank voltage (unconfirmed for this board: see board.yaml config)
set_property CFGBVS VCCO [current_design];
set_property CONFIG_VOLTAGE 3.3 [current_design];

## Asynchronous inputs: each is synchronised by two ASYNC_REG flops (sync2.sv); a zero input delay marks them
## constrained for check_timing and the false path removes them from timing analysis.
set async_in [get_ports {btn uart_rx}]
set_input_delay -clock sys_clk_pin 0.000 $async_in
set_false_path -from $async_in

## Slow outputs: LEDs and the UART transmit line are registered and nothing outside samples them against the clock.
set slow_out [get_ports {led[*] uart_tx}]
set_output_delay -clock sys_clk_pin 0.000 $slow_out
set_false_path -to $slow_out
