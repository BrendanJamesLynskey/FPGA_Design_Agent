## design.xdc: smoke design for the Digilent Arty S7-50, generated by tools/board_smoke.py through the core's board_constraints tool from the board's master XDC
## (Arty-S7-50-Master.xdc). Pins and I/O standards are the board's; do not edit pin numbers.

set_property -dict { PACKAGE_PIN G15  IOSTANDARD LVCMOS33 } [get_ports { btn }];  # btn[0]
set_property -dict { PACKAGE_PIN R2   IOSTANDARD SSTL135 } [get_ports { clk }];  # CLK100MHZ
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { clk }];
set_property -dict { PACKAGE_PIN E18  IOSTANDARD LVCMOS33 } [get_ports { led[0] }];  # led[0]
set_property -dict { PACKAGE_PIN F13  IOSTANDARD LVCMOS33 } [get_ports { led[1] }];  # led[1]
set_property -dict { PACKAGE_PIN E13  IOSTANDARD LVCMOS33 } [get_ports { led[2] }];  # led[2]
set_property -dict { PACKAGE_PIN H15  IOSTANDARD LVCMOS33 } [get_ports { led[3] }];  # led[3]
set_property -dict { PACKAGE_PIN H14  IOSTANDARD LVCMOS33 } [get_ports { sw[0] }];  # sw[0]
set_property -dict { PACKAGE_PIN H18  IOSTANDARD LVCMOS33 } [get_ports { sw[1] }];  # sw[1]
set_property -dict { PACKAGE_PIN G18  IOSTANDARD LVCMOS33 } [get_ports { sw[2] }];  # sw[2]
set_property -dict { PACKAGE_PIN M5   IOSTANDARD SSTL135 } [get_ports { sw[3] }];  # sw[3]
set_property -dict { PACKAGE_PIN V12  IOSTANDARD LVCMOS33 } [get_ports { uart_rx }];  # uart_txd_in
set_property -dict { PACKAGE_PIN R12  IOSTANDARD LVCMOS33 } [get_ports { uart_tx }];  # uart_rxd_out

## Configuration bank voltage (from the vendor XDC)
set_property CFGBVS VCCO [current_design];
set_property CONFIG_VOLTAGE 3.3 [current_design];

## Asynchronous inputs: each is synchronised by two ASYNC_REG flops (sync2.sv); a zero input delay marks them
## constrained for check_timing and the false path removes them from timing analysis.
set async_in [get_ports {btn sw[*] uart_rx}]
set_input_delay -clock sys_clk_pin 0.000 $async_in
set_false_path -from $async_in

## Slow outputs: LEDs and the UART transmit line are registered and nothing outside samples them against the clock.
set slow_out [get_ports {led[*] uart_tx}]
set_output_delay -clock sys_clk_pin 0.000 $slow_out
set_false_path -to $slow_out
